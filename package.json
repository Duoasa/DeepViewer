{
  "name": "@deepviewer/root",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "desktop:dev": "pnpm --filter @deepviewer/desktop dev",
    "desktop:dev:restart": "pnpm --filter @deepviewer/desktop dev:restart",
    "desktop:preview": "pnpm --filter @deepviewer/desktop preview",
    "desktop:release": "pnpm --filter @deepviewer/desktop release",
    "desktop:start": "pnpm --filter @deepviewer/desktop start",
    "desktop:package": "pnpm --filter @deepviewer/desktop package",
    "desktop:package:arm64": "pnpm --filter @deepviewer/desktop package:arm64",
    "desktop:package:x64": "pnpm --filter @deepviewer/desktop package:x64",
    "desktop:build": "pnpm --filter @deepviewer/desktop build",
    "test": "pnpm --filter @deepviewer/desktop test",
    "typecheck": "pnpm --filter @deepviewer/desktop typecheck"
  }
}
