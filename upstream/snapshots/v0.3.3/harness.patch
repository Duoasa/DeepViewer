+/**
+ * The browser tab's body: one address bar over one sandboxed frame.
+ *
+ * The same body serves both ways the tab opens.
+ *
+ * A **page** tab — picked from the guide page — types an address. Bare loopback
+ * addresses take `http`, everything else without a scheme takes `https`, and
+ * the page is framed as given.
+ *
+ * A **file** tab — which is every `.html` opened from the file tree, a chat
+ * link, or the produced-files row — frames a capability URL minted by the
+ * `preview-static` host plugin, so the page loads its own stylesheets, scripts,
+ * and images the way a browser would instead of being packed into a blob with
+ * no origin. That mode is why this body reads no bytes: the host serves them.
+ *
+ * The binding is where a file tab *starts*, not a cage. Its bar answers to both
+ * kinds of input — a relative `.html` path re-mints inside the workspace, and
+ * anything address-shaped navigates the tab out to the open web, which clears
+ * the binding and leaves an ordinary page tab behind. `resolvesInWorkspace`
+ * draws that line, and the sandbox follows whatever is actually framed.
+ *
+ * Two things the file mode deliberately does NOT do, because guessing them is
+ * how the preview lands on the wrong root:
+ * - it does not decide which workspace owns the file. A
+ *   `dsh-resource://file/session/…` address carries a path relative to the
+ *   *Session* cwd, and a Session may sit below the workspace it belongs to, so
+ *   the address alone cannot name a workspace. The host resolves containment
+ *   against every registered root and reports the relative path back.
+ * - it does not treat the address path as absolute. It rebuilds the absolute
+ *   path from the Session cwd, the only root the browser half holds reliably.
+ *
+ * A served document is framed same-site but sandboxed without
+ * `allow-same-origin`, so it runs in an opaque origin and cannot reach back into
+ * the app. A small bridge the host appends to served HTML reports the frame's
+ * location upward and accepts no command in return, which is how the address bar
+ * follows in-page navigation without the frame gaining any authority. A typed
+ * address keeps the wider sandbox an ordinary page needs — the user chose it.
+ */
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react'
+import type { FormEvent, ReactNode } from 'react'
+import type { InjectFace, PropsLocale, PropsRuntime, PropsStore } from '@deepseek-ai/dsh-client-ui-slots'
+import { IconGlobeOutline14, IconRefreshOutline16, IconRightUpOutline16 } from '@deepseek-ai/dsh-client-ui-primitives'
+import { parseFileAddress } from '@deepseek-ai/dsh-util-workspace-path'
+import type {} from './locales.ts'
+import {
+  absoluteEntryOf,
+  absolutePathFor,
+  displayPathOf,
+  normalizeAddress,
+  parsePreviewBrowserLocation,
+  PreviewSiteError,
+  resolvesInWorkspace,
+} from './site-url.ts'
+import type { PreviewSite } from './site-url.ts'
+import type { createBrowserStore } from './store.ts'
+import css from './BrowserBody.module.css'
+
+/**
+ * The sandbox a typed address gets: an ordinary page needs scripts, forms, and
+ * its own origin, and visiting it is the user's own choice.
+ */
+const PAGE_SANDBOX = 'allow-scripts allow-same-origin allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-downloads'
+
+/**
+ * The sandbox a workspace file gets: no `allow-same-origin`, so the served
+ * document runs in an opaque origin and cannot reach the app embedding it.
+ */
+const FILE_SANDBOX = 'allow-scripts'
+
+/** Ordinary Remote call the host plugin's `site` endpoint answers. */
+export type RequestPreviewSite = (absolutePath: string, signal: AbortSignal) => Promise<PreviewSite>
+
+/** This body's entry-level injected face, bound by its Slot registration. */
+export interface BrowserInjected {
+  /** Mint a capability URL for one absolute HTML path. */
+  readonly requestSite: RequestPreviewSite
+}
+
+/** The body's composed props: the tab it draws, its store, its Remote call, and its copy. */
+export type BrowserBodyProps =
+  & PropsRuntime<'sidebar.right.pane.tab'>
+  & PropsStore<ReturnType<typeof createBrowserStore>>
+  & InjectFace<BrowserInjected>
+  & PropsLocale<'sidebarBrowser'>
+
+/**
+ * Turn a mint failure into copy, translating the codes worth explaining.
+ * @param error - whatever `requestSite` rejected with.
+ * @param t - namespace-bound translate.
+ * @returns the line to show.
+ */
+function failureText(error: unknown, t: BrowserBodyProps['t']): string {
+  if (error instanceof PreviewSiteError) {
+    if (error.code === 'outside-workspace') return t('file.noWorkspace')
+    if (error.code === 'not-loopback') return t('file.notLoopback')
+  }
+  return error instanceof Error ? error.message : String(error)
+}
+
+/** The browser tab's body: the address bar, then the frame or the empty state. */
+export function BrowserBody({
+  useTabInfo, sessionId, useSessions, useStore, actions, requestSite, t,
+}: BrowserBodyProps): ReactNode {
+  const { tab } = useTabInfo()
+  const { signal } = tab
+  const state = useStore(store => store.byTab[tab.id])
+
+  // A file tab is bound at open time: its contentId is the address it was
+  // claimed at. The binding is what the bar starts on, not a cage — a typed
+  // address leaves it behind and the tab becomes an ordinary page tab.
+  const address = useMemo(() => parseFileAddress(tab.contentId), [tab.contentId])
+  const cwd = useSessions(store => store.byId[sessionId]?.cwd)
+  const entry = useMemo(
+    () => (address === undefined ? undefined : absoluteEntryOf(address.path, cwd)),
+    [address, cwd],
+  )
+
+  // One mint per entry. Seeded from the store so a remount — a pane move, a tab
+  // switch — keeps the frame it already had instead of minting again; the guard
+  // keeps a failed mint from retrying on every store write.
+  const [attempted, setAttempted] = useState<string | undefined>(() => (
+    state?.committed !== undefined && state.file?.absolutePath === entry ? entry : undefined
+  ))
+  const [pending, setPending] = useState(false)
+  const frameRef = useRef<HTMLIFrameElement | null>(null)
+
+  // Never re-open the file once the reader has navigated away from it: a tab
+  // whose binding was cleared is a page tab that merely happens to have been
+  // opened at a file address.
+  const wantsFile = state === undefined || state.committed === undefined || state.file !== undefined
+
+  // The record's abort ends the bucket's life: a closed (or replaced) tab
+  // keeps no address behind.
+  useEffect(() => {
+    const forget = (): void => { actions.forget(tab.id) }
+    signal.addEventListener('abort', forget)
+    return () => { signal.removeEventListener('abort', forget) }
+  }, [actions, tab.id, signal])
+
+  const mint = useCallback(async (absolutePath: string): Promise<void> => {
+    setPending(true)
+    try {
+      const site = await requestSite(absolutePath, signal)
+      actions.openFile(tab.id, { absolutePath, entryPath: site.entryPath }, site.url)
+    } catch (error) {
+      actions.fail(tab.id, failureText(error, t))
+    } finally {
+      setPending(false)
+    }
+  }, [actions, requestSite, signal, t, tab.id])
+
+  useEffect(() => {
+    if (entry === undefined || !wantsFile || attempted === entry) return
+    setAttempted(entry)
+    void mint(entry)
+  }, [attempted, entry, mint, wantsFile])
+
+  const file = state?.file
+  // Only this frame's reports count; the sandbox gives it no other way to speak.
+  useEffect(() => {
+    if (file === undefined) return
+    const receive = (event: MessageEvent<unknown>): void => {
+      if (event.source !== frameRef.current?.contentWindow) return
+      const location = parsePreviewBrowserLocation(event.data)
+      if (location === undefined) return
+      const display = displayPathOf(location.href, file.entryPath)
+      if (display !== undefined) actions.setDraft(tab.id, display)
+    }
+    window.addEventListener('message', receive)
+    return () => { window.removeEventListener('message', receive) }
+  }, [actions, file, tab.id])
+
+  const submit = (event: FormEvent): void => {
+    event.preventDefault()
+    const draft = state?.draft ?? ''
+    // A file tab's bar answers to both: a relative `.html` path re-mints inside
+    // the workspace, and anything address-shaped leaves for the open web.
+    if (file !== undefined && resolvesInWorkspace(draft)) {
+      const next = absolutePathFor(file.absolutePath, draft)
+      if (next === undefined) {
+        // A refused path snaps back to the page actually framed.
+        actions.setDraft(tab.id, file.entryPath)
+        return
+      }
+      void mint(next)
+      return
+    }
+    const url = normalizeAddress(draft)
+    if (url !== undefined) actions.navigate(tab.id, url)
+  }
+
+  const reload = (): void => {
+    if (file !== undefined) void mint(file.absolutePath)
+    else actions.reload(tab.id)
+  }
+
+  if (address !== undefined && entry === undefined) {
+    return (
+      <div className={css.status} data-browser-state="unavailable">
+        <p className={css.statusLine} role="alert">{t('file.noWorkspace')}</p>
+      </div>
+    )
+  }
+
+  const committed = state?.committed
+  return (
+    <div className={css.root} data-browser-root data-browser-mode={file === undefined ? 'page' : 'file'}>
+      <form className={css.bar} onSubmit={submit}>
+        <input
+          className={css.address}
+          value={state?.draft ?? ''}
+          placeholder={address === undefined ? t('address.placeholder') : t('file.address')}
+          aria-label={address === undefined ? t('address.placeholder') : t('file.address')}
+          spellCheck={false}
+          autoCapitalize="off"
+          autoCorrect="off"
+          data-browser-address
+          onChange={(event) => { actions.setDraft(tab.id, event.currentTarget.value) }}
+        />
+        <button
+          type="submit"
+          className={css.tool}
+          aria-label={t('visit')}
+          title={t('visit')}
+          disabled={pending}
+          data-browser-visit
+        >
+          <IconRightUpOutline16 />
+        </button>
+        <button
+          type="button"
+          className={css.tool}
+          aria-label={t('reload')}
+          title={t('reload')}
+          disabled={committed === undefined || pending}
+          data-browser-reload
+          onClick={reload}
+        >
+          <IconRefreshOutline16 />
+        </button>
+      </form>
+      {state?.failure !== undefined && (
+        <p className={css.failure} role="alert" data-browser-failed>{state.failure}</p>
+      )}
+      {committed === undefined
+        ? (
+          <div className={css.empty} data-browser-state="empty">
+            <IconGlobeOutline14 size={28} className={css.emptyGlyph} />
+            <p className={css.emptyLine}>{address === undefined ? t('empty') : t('file.opening')}</p>
+          </div>
+        )
+        : (
+          <iframe
+            key={`${committed}:${String(state?.nonce ?? 0)}`}
+            ref={frameRef}
+            className={css.frame}
+            src={committed}
+            title={t('frame.title')}
+            // The sandbox follows what is actually framed, not how the tab was
+            // opened: once the reader leaves the workspace, the document is an
+            // ordinary site and needs the ordinary sandbox back.
+            sandbox={file === undefined ? PAGE_SANDBOX : FILE_SANDBOX}
+            referrerPolicy="no-referrer"
+            data-browser-frame
+          />
+        )}
+    </div>
+  )
+}
