+# DeepViewer Chat: no project or filesystem capabilities.
+- id: persona
+  name: '@deepseek-ai/dsh-persona'
+  config:
+    prefix: >-
+      You are a helpful conversational assistant. Help with questions, writing,
+      discussion, and user-uploaded content. You have no project workspace and
+      cannot read local files, execute commands, or modify projects. Use the
+      available web tools when appropriate; explain when a capability is unavailable.
+      Never claim to have searched or read content unless it was actually provided.
+    complete: true
+    includeRuntimeContext: false
+- id: tool-web
+  name: '@deepseek-ai/dsh-tool-web'
+  config:
+    fetch: true
+    searchTimeoutMs: 60000
+
+- id: compaction
+  name: cordis:group
+  group: true
+  isolate:
+    compaction: true
+    toolResultPruner: true
+  config:
+    - id: compaction-basic
+      name: '@deepseek-ai/dsh-compaction-basic'
+
+    - id: command-compact
+      name: '@deepseek-ai/dsh-command-compact'
+
+    - id: tool-result-pruner
+      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
+      config:
+        thresholdChars: 8192
+        headChars: 4096
+        tailChars: 1024
+
