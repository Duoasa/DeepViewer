+// @vitest-environment jsdom
+/**
+ * Stage one, as the registry sees it.
+ *
+ * The type is one definition doing two jobs: a page the guide offers, and the
+ * claim that takes every `.html` file away from the plain `text` viewer without
+ * taking anything else. The band does the first half, `canOpen` the second, and
+ * both are asserted through the real registry so the ranking is what is tested
+ * rather than a restatement of the fields.
+ */
+import { afterEach, describe, expect, it } from 'vitest'
+import { createElement } from 'react'
+import { cleanup, render } from '@testing-library/react'
+import { Context } from '@deepseek-ai/cordis'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { sessionFileAddress } from '@deepseek-ai/dsh-util-workspace-path'
+import { SidebarRightTabRegistry } from '@deepseek-ai/dsh-client-ui-sidebar-right/src/client/tab-registry.ts'
+import {
+  BROWSER_ID, BROWSER_KIND, browserDefinition, browserTitle, isHtmlFileAddress,
+} from '../src/client/definition.tsx'
+import { zh } from '../src/client/locales.ts'
+
+const t = makeTranslate(zh)
+
+/** The plain file viewer every other suffix must keep falling through to. */
+const TEXT_VIEWER = {
+  id: 'text-viewer',
+  kind: 'text',
+  patterns: ['dsh-resource://file/**'],
+  priority: 'fallback' as const,
+  title: (address: string) => address,
+}
+
+afterEach(cleanup)
+
+describe('browserDefinition', () => {
+  it('claims HTML file addresses and leaves every other suffix alone', () => {
+    expect(isHtmlFileAddress(sessionFileAddress('s-1', '/w/pages/index.html'))).toBe(true)
+    expect(isHtmlFileAddress(sessionFileAddress('s-1', '/w/pages/INDEX.HTM'))).toBe(true)
+    expect(isHtmlFileAddress(sessionFileAddress('s-1', '/w/notes.md'))).toBe(false)
+    expect(isHtmlFileAddress(sessionFileAddress('s-1', '/w/photo.png'))).toBe(false)
+    expect(isHtmlFileAddress('sidebar://browser')).toBe(false)
+    expect(isHtmlFileAddress('not an address')).toBe(false)
+  })
+
+  it('wins an HTML address against the fallback text viewer, and only that address', () => {
+    const registry = new SidebarRightTabRegistry(new Context())
+    registry.register(TEXT_VIEWER)
+    registry.register(browserDefinition(t))
+    expect(registry.claim(sessionFileAddress('s-1', '/w/index.html')).kind).toBe(BROWSER_KIND)
+    expect(registry.claim(sessionFileAddress('s-1', '/w/notes.md')).kind).toBe('text')
+    expect(registry.candidates(sessionFileAddress('s-1', '/w/notes.md')).map(entry => entry.kind))
+      .toEqual(['text'])
+  })
+
+  it('offers the guide page one entry at order 20 that opens the browser kind', () => {
+    const registry = new SidebarRightTabRegistry(new Context())
+    registry.register(browserDefinition(t))
+    const [entry, ...rest] = registry.guide()
+    expect(rest).toEqual([])
+    expect(entry?.order).toBe(20)
+    expect(entry?.kind).toBe(BROWSER_KIND)
+    expect(entry?.title()).toBe(zh['guide.title'])
+    expect(entry?.description?.()).toBe(zh['guide.description'])
+    if (entry?.icon === undefined) throw new Error('expected the guide icon')
+    const icon = render(createElement(entry.icon, { size: 26 }))
+    expect(icon.container.querySelector('svg')?.getAttribute('width')).toBe('26')
+  })
+
+  it('sits in the builtin band', () => {
+    const definition = browserDefinition(t)
+    expect(definition.id).toBe(BROWSER_ID)
+    expect(definition.priority).toBe('builtin')
+    expect(definition.patterns).toEqual(['dsh-resource://file/**'])
+  })
+
+  it('titles a file tab by its basename and a page tab by the dictionary', () => {
+    const title = browserTitle(t)
+    expect(title(sessionFileAddress('s-1', '/w/pages/about-me.html'))).toBe('about-me.html')
+    expect(title('sidebar://browser')).toBe(zh['type.label'])
+    expect(title('nonsense')).toBe(zh['type.label'])
+  })
+
+  it('reads a decoded basename, so a spaced name shows as itself', () => {
+    expect(browserTitle(t)(sessionFileAddress('s-1', '/w/my page.html'))).toBe('my page.html')
+  })
+})
