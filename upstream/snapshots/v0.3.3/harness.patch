index 0000000000000000000000000000000000000000..73ee54629a3b8198bdd743c37c8cd656deff2ac5
--- /dev/null
+++ b/packages/client/ui-sidebar-browser/src/client/site-url.ts
@@ -0,0 +1,231 @@
+/**
+ * Address arithmetic for the browser tab's workspace-page mode.
+ *
+ * When the tab is opened at a `dsh-resource://file/…` address, the framed URL
+ * is not that address but a capability URL —
+ * `/deepviewer-preview-static/<token>/<asset>`. The address bar therefore shows
+ * the workspace-relative path the host reported, and a path typed back in
+ * resolves against the entry's own directory. Nothing here reaches the host:
+ * the URL is minted by the `preview-static` plugin, and this module only
+ * decides what to show and what to ask for next.
+ *
+ * The one trap this module exists to absorb: a `dsh-resource://file/session/…`
+ * address carries a path **relative to the Session's cwd** whenever the file
+ * sits under it (see `fileAddressFor`), so the address alone never names an
+ * absolute file. {@link absoluteEntryOf} rebuilds the absolute path from the
+ * Session cwd, and the host turns it back into a workspace-relative one.
+ */
+import { isAbsoluteWorkspacePath } from '@deepseek-ai/dsh-util-workspace-path'
+
+/** Message source the served navigation bridge puts on every report. */
+export const PREVIEW_BROWSER_MESSAGE_SOURCE = 'deepviewer-preview-browser'
+
+/** HTTP prefix every capability URL hangs under. */
+export const PREVIEW_STATIC_PREFIX = '/deepviewer-preview-static'
+
+/**
+ * Logical RPC channel the capability is minted on.
+ *
+ * Spelled here as well as in the host plugin because the two halves are
+ * separate build faces with no shared runtime import: the host half must not
+ * reach the browser bundle, and the browser bundle must not pull in a Node
+ * package. The channel name is the whole contract between them.
+ */
+export const PREVIEW_RPC_CHANNEL = '/deepviewer-preview'
+
+/** A scheme-with-authority prefix the address already carries. */
+const ABSOLUTE_URL = /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//
+
+/** Loopback spellings that expect plain http when no scheme is given. */
+const LOOPBACK_HOST = /^(?:localhost|127(?:\.\d{1,3}){3}|0\.0\.0\.0|\[::1\])(?::\d+)?(?:[/?#]|$)/i
+
+/** The suffixes this tab serves from the workspace, matching the type's own claim. */
+const WORKSPACE_ENTRY = /\.html?$/iu
+
+/**
+ * Turn the bar's text into a navigable URL: bare loopback addresses take
+ * `http`, everything else without a scheme takes `https`.
+ * @param input - the address bar's raw text.
+ * @returns the URL to show, or undefined for an empty bar.
+ */
+export function normalizeAddress(input: string): string | undefined {
+  const text = input.trim()
+  if (text === '') return undefined
+  if (ABSOLUTE_URL.test(text)) return text
+  if (LOOPBACK_HOST.test(text)) return `http://${text}`
+  return `https://${text}`
+}
+
+/**
+ * Whether the bar's text names a page inside the workspace rather than an address.
+ *
+ * A file tab has to serve both: clicking through to the page beside the one it
+ * is showing, and leaving the workspace for the open web. The input's shape
+ * decides, in three steps — a scheme or a loopback authority is never a
+ * workspace path; only an HTML suffix can be one, since those are exactly the
+ * entries this type claims; and a multi-segment path whose first segment carries
+ * a dot reads as a host, the way any browser reads it, so `example.com/page.html`
+ * stays a URL while `pages/index.html` stays a workspace path. The cost of that
+ * last rule is a workspace directory whose own name contains a dot, which has to
+ * be reached from the file tree rather than typed.
+ *
+ * `notes.md` therefore falls through to an address, which is what typing it into
+ * a browser bar means anyway.
+ * @param input - the address bar's raw text.
+ * @returns true when the text should be resolved and minted as a workspace entry.
+ */
+export function resolvesInWorkspace(input: string): boolean {
+  const text = input.trim()
+  if (text === '' || ABSOLUTE_URL.test(text) || LOOPBACK_HOST.test(text)) return false
+  if (text.startsWith('/') || text.includes('\\')) return false
+  const path = text.split(/[?#]/u, 1)[0] ?? ''
+  if (!WORKSPACE_ENTRY.test(path)) return false
+  // Leading `.` / `..` segments are navigation, not a host name.
+  const segments = path.replace(/^(?:\.\.?\/)+/u, '').split('/')
+  return segments.length === 1 || !(segments[0] ?? '').includes('.')
+}
+
+/** One location report from the framed document. */
+export interface PreviewBrowserLocation {
+  /** The frame's absolute URL. */
+  readonly href: string
+  /** The frame's `document.title`. */
+  readonly title: string
+}
+
+/** The `site` endpoint's answer. */
+export interface PreviewSite {
+  /** Relative URL to frame, resolved by the browser against the app origin. */
+  readonly url: string
+  /** Epoch milliseconds after which {@link url} stops working. */
+  readonly expiresAt: number
+  /** The entry's path relative to the workspace that contains it, for display. */
+  readonly entryPath: string
+}
+
+/** A capability failure that kept the host's machine-readable code. */
+export class PreviewSiteError extends Error {
+  /**
+   * @param code - the host's failure code.
+   * @param message - the host's English message, shown verbatim when unrecognized.
+   */
+  constructor(readonly code: string, message: string) {
+    super(message)
+    this.name = 'PreviewSiteError'
+  }
+}
+
+/**
+ * Rebuild the entry's absolute path from a file address's path.
+ *
+ * A `session`-scoped address relativizes the path against the Session cwd, so a
+ * relative path is only resolvable when that cwd is known; an address path that
+ * is already absolute (a file outside the Session's workspace) passes through.
+ * @param addressPath - `parseFileAddress(address).path`.
+ * @param cwd - the Session's workspace root, when known.
+ * @returns the absolute entry path, or undefined when a relative path has no root to resolve against.
+ */
+export function absoluteEntryOf(addressPath: string, cwd: string | undefined): string | undefined {
+  if (isAbsoluteWorkspacePath(addressPath)) return addressPath
+  if (cwd === undefined || cwd === '') return undefined
+  const root = cwd.replaceAll('\\', '/').replace(/\/+$/u, '')
+  if (root === '') return undefined
+  return addressPath === '' ? root : `${root}/${addressPath}`
+}
+
+/**
+ * Parse one `message` event payload from the served navigation bridge.
+ * @param value - the event's `data`.
+ * @returns the location, or undefined when this is not one of ours.
+ */
+export function parsePreviewBrowserLocation(value: unknown): PreviewBrowserLocation | undefined {
+  if (typeof value !== 'object' || value === null) return undefined
+  const message = value as Record<string, unknown>
+  if (message.source !== PREVIEW_BROWSER_MESSAGE_SOURCE || message.type !== 'location') return undefined
+  if (typeof message.href !== 'string' || typeof message.title !== 'string') return undefined
+  return { href: message.href, title: message.title }
+}
+
+/** Parse a URL without throwing. */
+function absoluteUrl(value: string, base: string): URL | undefined {
+  try {
+    return new URL(value, base)
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * The asset path inside a capability URL.
+ * @param href - the framed URL, absolute or relative.
+ * @returns the decoded asset path, or undefined when this is not a capability URL.
+ */
+export function assetPathOf(href: string): string | undefined {
+  const url = absoluteUrl(href, 'http://preview.invalid')
+  // The trailing slash is part of the match: without it a sibling route that
+  // merely shares the prefix would read as a capability route.
+  const prefix = `${PREVIEW_STATIC_PREFIX}/`
+  if (url === undefined || !url.pathname.startsWith(prefix)) return undefined
+  const suffix = url.pathname.slice(prefix.length)
+  const tokenEnd = suffix.indexOf('/')
+  if (tokenEnd <= 0) return undefined
+  const encoded = suffix.slice(tokenEnd + 1)
+  if (encoded === '') return undefined
+  try {
+    return decodeURIComponent(encoded)
+  } catch {
+    // A malformed escape is not worth an exception; the raw form still reads.
+    return encoded
+  }
+}
+
+/**
+ * The workspace-relative path to show for one framed URL.
+ *
+ * A capability is rooted at the entry's directory, so the framed asset path is
+ * re-anchored there: framing `styles/site.css` beside `pages/index.html` reads
+ * as `pages/styles/site.css`.
+ * @param href - the framed URL.
+ * @param entryPath - the workspace-relative path the capability was minted for.
+ * @returns the display path, or undefined when the URL is not a capability URL.
+ */
+export function displayPathOf(href: string, entryPath: string): string | undefined {
+  const asset = assetPathOf(href)
+  if (asset === undefined) return undefined
+  const directory = entryPath.split('/').slice(0, -1)
+  return [...directory, ...asset.split('/')].filter(segment => segment !== '').join('/')
+}
+
+/**
+ * Resolve an address-bar input against the entry's own directory.
+ *
+ * The bar takes a path relative to the entry, which is the only root the
+ * browser half knows: the host reports the entry's workspace-relative path for
+ * display, but navigation never has to name a workspace. An absolute path, a
+ * scheme, or a `..` that climbs above the filesystem root all refuse; the host
+ * re-checks containment anyway, so pointing outside the workspace is reported
+ * by the capability mint rather than silently served.
+ * @param currentAbsolute - the absolute path of the entry currently framed.
+ * @param input - the address bar's raw text.
+ * @returns the next absolute path, or undefined when the input refuses.
+ */
+export function absolutePathFor(currentAbsolute: string, input: string): string | undefined {
+  const value = input.trim().split(/[?#]/u, 1)[0] ?? ''
+  if (value === '' || value.startsWith('/') || value.includes('\\') || /^[a-z][a-z\d+.-]*:/iu.test(value)) {
+    return undefined
+  }
+  const cut = currentAbsolute.lastIndexOf('/')
+  if (cut <= 0) return undefined
+  const segments = currentAbsolute.slice(0, cut).split('/')
+  for (const segment of value.split('/')) {
+    if (segment === '' || segment === '.') continue
+    if (segment === '..') {
+      // Index 0 is the empty segment before the leading slash; never pop it.
+      if (segments.length <= 1) return undefined
+      segments.pop()
+      continue
+    }
+    segments.push(segment)
+  }
+  return segments.length <= 1 ? undefined : segments.join('/')
+}
diff --git a/packages/client/ui-sidebar-browser/src/client/store.ts b/packages/client/ui-sidebar-browser/src/client/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ed6ceb3e7395a05eebd24a451f4125f874c75f23
--- /dev/null
+++ b/packages/client/ui-sidebar-browser/src/client/store.ts
@@ -0,0 +1,155 @@
+/**
+ * The browser tab's view state: the address bar's text, the URL the frame
+ * shows, and the reload counter.
+ *
+ * The tab has two modes and one bucket holds both. A **page** tab — opened from
+ * the guide page — is a typed address over a frame, and `navigate` records it.
+ * A **file** tab — opened at a `dsh-resource://file/…` address, which is how
+ * every `.html` in the workspace opens — frames a capability URL minted by the
+ * `preview-static` host plugin instead, and `openFile` records the pair the bar
+ * needs: the entry's absolute path to resolve the next input against, and the
+ * workspace-relative path to show.
+ *
+ * One Slot-standard exclusive store per session, bucketed by tab id because
+ * two browser tabs in one session navigate independently. Buckets are created
+ * lazily by the first write, so a tab that was never touched keeps no state;
+ * `forget` runs when the tab record's signal aborts.
+ */
+import { defineStore, type EngineStoreHandle } from '@deepseek-ai/dsh-client-store'
+
+/** Where a file-bound tab's frame came from, as the bar needs it. */
+export interface BrowserFileBinding {
+  /** The entry's absolute path; the address bar's next input resolves against it. */
+  readonly absolutePath: string
+  /** The entry's workspace-relative path, reported by the host, which is what the bar shows. */
+  readonly entryPath: string
+}
+
+/** One tab's browser state. */
+export interface BrowserTabState {
+  /** The address bar's text, kept across body remounts. */
+  draft: string
+  /** The URL the frame currently shows; undefined until the first visit. */
+  committed: string | undefined
+  /** Reload counter: changing it remounts the frame at the same URL. */
+  nonce: number
+  /** Set while this tab frames a workspace file rather than a typed address. */
+  file: BrowserFileBinding | undefined
+  /** The last capability failure, cleared by the next success. */
+  failure: string | undefined
+}
+
+/** Every tab's browser state, keyed by tab id. */
+export interface BrowserState {
+  byTab: Record<string, BrowserTabState>
+}
+
+/** The browser store's write set; every action names the tab it writes. */
+type BrowserActions = {
+  setDraft: (draft: BrowserState, tabId: string, text: string) => void
+  navigate: (draft: BrowserState, tabId: string, url: string) => void
+  openFile: (draft: BrowserState, tabId: string, binding: BrowserFileBinding, url: string) => void
+  fail: (draft: BrowserState, tabId: string, message: string) => void
+  reload: (draft: BrowserState, tabId: string) => void
+  forget: (draft: BrowserState, tabId: string) => void
+}
+
+/**
+ * One tab's bucket, created on first write: reading through the component
+ * treats an absent bucket as the empty address bar.
+ * @param state - the draft.
+ * @param tabId - the tab being written.
+ * @returns the tab's browser state.
+ */
+function bucket(state: BrowserState, tabId: string): BrowserTabState {
+  const existing = state.byTab[tabId]
+  if (existing !== undefined) return existing
+  const created: BrowserTabState = {
+    draft: '', committed: undefined, nonce: 0, file: undefined, failure: undefined,
+  }
+  state.byTab[tabId] = created
+  return created
+}
+
+/**
+ * Declare the browser store.
+ *
+ * A factory rather than a shared handle: the registration declares it as an
+ * exclusive store, so the framework mints one instance per session.
+ * @returns the store handle to declare on the registration.
+ */
+export function createBrowserStore(): EngineStoreHandle<BrowserState, BrowserActions> {
+  return defineStore({
+    init: (): BrowserState => ({ byTab: {} }),
+    actions: {
+      /**
+       * Keep the address bar's text.
+       * @param d - draft state.
+       * @param tabId - the tab being drawn.
+       * @param text - the bar's current text.
+       */
+      setDraft: (d, tabId, text) => {
+        bucket(d, tabId).draft = text
+      },
+      /**
+       * Point a page tab's frame at a URL, and echo it in the bar.
+       *
+       * A typed address also leaves file mode: the tab is no longer bound to the
+       * workspace entry it may have been opened at.
+       * @param d - draft state.
+       * @param tabId - the tab being drawn.
+       * @param url - the normalized URL to show.
+       */
+      navigate: (d, tabId, url) => {
+        const state = bucket(d, tabId)
+        state.draft = url
+        state.committed = url
+        state.file = undefined
+        state.failure = undefined
+      },
+      /**
+       * Point a file tab at a freshly minted capability URL.
+       *
+       * The bar shows the entry path rather than the token URL, and the nonce
+       * rises so a reload at the same URL still remounts the frame.
+       * @param d - draft state.
+       * @param tabId - the tab being drawn.
+       * @param binding - the entry's absolute and workspace-relative paths.
+       * @param url - the capability URL to frame.
+       */
+      openFile: (d, tabId, binding, url) => {
+        const state = bucket(d, tabId)
+        state.file = binding
+        state.draft = binding.entryPath
+        state.committed = url
+        state.failure = undefined
+        state.nonce += 1
+      },
+      /**
+       * Record why a capability could not be minted.
+       * @param d - draft state.
+       * @param tabId - the tab being drawn.
+       * @param message - the line to show under the bar.
+       */
+      fail: (d, tabId, message) => {
+        bucket(d, tabId).failure = message
+      },
+      /**
+       * Remount a page tab's frame at its current URL.
+       * @param d - draft state.
+       * @param tabId - the tab being drawn.
+       */
+      reload: (d, tabId) => {
+        bucket(d, tabId).nonce += 1
+      },
+      /**
+       * Forget one tab's browser state, for a tab record that is gone.
+       * @param d - draft state.
+       * @param tabId - the tab that went away.
+       */
+      forget: (d, tabId) => {
+        d.byTab = Object.fromEntries(Object.entries(d.byTab).filter(([id]) => id !== tabId))
+      },
+    },
+  })
+}
