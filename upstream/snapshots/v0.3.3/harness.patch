+/* The pane body is a flex column with a definite height: the address bar
+   stays put at the top and the frame takes everything below. */
+.root {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  height: 100%;
+  min-height: 0;
+  color: var(--dsw-alias-label-primary);
+  font-size: var(--dsh-content-font-size-secondary, 13px);
+  line-height: 1.5;
+}
+
+/* One 38px row flush under the pane's strip, matching the file tree and
+   document preview headers: the address field, then visit and reload. */
+.bar {
+  display: flex;
+  flex: 0 0 auto;
+  gap: 4px;
+  align-items: center;
+  box-sizing: border-box;
+  height: 38px;
+  margin: 0;
+  padding: 0 6px 0 12px;
+  border-bottom: 0.5px solid var(--dsw-alias-border-l3);
+}
+
+.address {
+  flex: 1 1 auto;
+  min-width: 0;
+  height: 26px;
+  box-sizing: border-box;
+  padding: 0 8px;
+  border: 0.5px solid var(--dsw-alias-border-l3);
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-primary);
+  font-size: 12px;
+  outline: none;
+}
+
+.address:focus {
+  border-color: var(--dsw-alias-label-tertiary);
+}
+
+.address::placeholder {
+  color: var(--dsw-alias-label-tertiary);
+}
+
+/* Square icon button, the document preview's `.tool` dress. */
+.tool {
+  display: flex;
+  flex: 0 0 auto;
+  align-items: center;
+  justify-content: center;
+  width: 26px;
+  height: 26px;
+  padding: 0;
+  border: none;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary, var(--dsw-alias-label-primary));
+  cursor: pointer;
+}
+
+.tool:hover:not(:disabled) {
+  background: var(--dsw-alias-fill-quaternary, rgba(127, 127, 127, 0.12));
+}
+
+.tool:disabled {
+  cursor: default;
+  opacity: 0.4;
+}
+
+.empty {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 8px;
+  align-items: center;
+  justify-content: center;
+  min-height: 0;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.emptyGlyph {
+  flex: none;
+}
+
+.emptyLine {
+  margin: 0;
+  font-size: 12px;
+}
+
+/* Pages render their own ground; an opaque white base keeps transparent
+   pages readable under either theme. */
+.frame {
+  flex: 1 1 auto;
+  width: 100%;
+  min-height: 0;
+  border: none;
+  background: white;
+}
+
+/* A capability-mint failure for a file tab sits under the bar: the previous
+   frame is gone, so there is nothing to overlay. */
+.failure {
+  flex: 0 0 auto;
+  margin: 0;
+  padding: 8px 12px;
+  border-bottom: 0.5px solid var(--dsw-alias-border-l3);
+  color: var(--dsw-alias-label-secondary, var(--dsw-alias-label-primary));
+  font-size: 12px;
+}
+
+/* A file address whose Session root is unknown has nothing to draw at all. */
+.status {
+  display: flex;
+  flex: 1 1 auto;
+  align-items: center;
+  justify-content: center;
+  min-height: 0;
+  padding: 0 16px;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.statusLine {
+  margin: 0;
+  font-size: 12px;
+  text-align: center;
+}
