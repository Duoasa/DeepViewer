index 0000000000000000000000000000000000000000..4fa2d8b013a7e3bc76891c4ca2dc1ba5c3128dac
--- /dev/null
+++ b/packages/client/ui-sidebar-browser/src/client/definition.tsx
@@ -0,0 +1,87 @@
+/**
+ * Stage one of this package's registration: what the `browser` tab type IS.
+ *
+ * The type is both a page and a viewer. The guide page offers it as an entry
+ * box — picking that box opens the page with an empty address bar — and it also
+ * claims every `.html` / `.htm` file address in the workspace, so opening one
+ * from the file tree, a chat link, or the produced-files row lands in the
+ * browser rather than in the document preview.
+ *
+ * The band is what makes that claim win. `text` claims the same addresses at
+ * `fallback` (it is the plain viewer anything more specific should beat), so a
+ * `builtin` claim takes every HTML file while leaving every other file to it.
+ * `canOpen` is what narrows the claim to HTML: without it the browser would
+ * outrank the document preview for Markdown, images, and PDFs too.
+ */
+import type { SidebarRightTabDefinition } from '@deepseek-ai/dsh-client-ui-sidebar-right/client'
+import type { TranslateNS } from '@deepseek-ai/dsh-client-locale/client'
+import { parseFileAddress } from '@deepseek-ai/dsh-util-workspace-path'
+import type {} from './locales.ts'
+import { IconGlobeOutline14, type IconProps } from '@deepseek-ai/dsh-client-ui-primitives'
+
+/** The tab kind this package owns. */
+export const BROWSER_KIND = 'browser'
+
+/** This implementation's identity in the tab system, and the key its body registers under. */
+export const BROWSER_ID = '@deepseek-ai/dsh-client-ui-sidebar-browser'
+
+/** The suffixes this type serves as a page. */
+const HTML_SUFFIX = /\.html?$/iu
+
+/**
+ * Whether an address names a file this type can serve.
+ *
+ * The registry runs this on every routing decision, so it stays cheap and
+ * synchronous: it reads the address, never the filesystem.
+ * @param address - the `dsh-resource://` address being routed.
+ * @returns true for an `.html` / `.htm` file address.
+ */
+export function isHtmlFileAddress(address: string): boolean {
+  const file = parseFileAddress(address)
+  return file !== undefined && HTML_SUFFIX.test(file.path)
+}
+
+/**
+ * The tab chip's text for one address.
+ *
+ * A file tab is named by its own basename — the address is decoded already, so
+ * a name carrying a space reads as itself — and a page tab, opened by kind at
+ * `sidebar://browser`, falls back to the type's own label.
+ * @param t - namespace-bound translate.
+ * @returns the title reader the registry captures at open time.
+ */
+export function browserTitle(t: TranslateNS<'sidebarBrowser'>): (address: string) => string {
+  return (address) => {
+    const file = parseFileAddress(address)
+    if (file === undefined) return t('type.label')
+    const name = file.path.slice(file.path.lastIndexOf('/') + 1)
+    return name === '' ? t('type.label') : name
+  }
+}
+
+/** The type's globe at the guide capsule's glyph size. */
+function GlobeGlyph({ size, className }: IconProps) {
+  return <IconGlobeOutline14 size={size} className={className} />
+}
+
+/**
+ * The browser type's registry definition.
+ * @param t - namespace-bound translate, read fresh on every label call.
+ * @returns the definition to register.
+ */
+export function browserDefinition(t: TranslateNS<'sidebarBrowser'>): SidebarRightTabDefinition {
+  return {
+    id: BROWSER_ID,
+    kind: BROWSER_KIND,
+    priority: 'builtin',
+    patterns: ['dsh-resource://file/**'],
+    canOpen: isHtmlFileAddress,
+    title: browserTitle(t),
+    guide: [{
+      order: 20,
+      title: () => t('guide.title'),
+      description: () => t('guide.description'),
+      icon: GlobeGlyph,
+    }],
+  }
+}
