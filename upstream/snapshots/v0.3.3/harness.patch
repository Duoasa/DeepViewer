diff --git a/packages/client/ui-sidebar-browser/tests/apply.client.spec.ts b/packages/client/ui-sidebar-browser/tests/apply.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2fe8c7cdd28c0aed8619aa82f98b5ce9c96befbb
--- /dev/null
+++ b/packages/client/ui-sidebar-browser/tests/apply.client.spec.ts
@@ -0,0 +1,125 @@
+/**
+ * The plugin's registrations, and their removal when the plugin goes.
+ *
+ * The tab registry is real, because "registered" means what it says: which type
+ * claims which address. The slot and locale faces are recorders, because what
+ * matters here is what was handed to them — one body seat under the type's id,
+ * with its store and its bound Remote call — and that every registration is
+ * gone after dispose, which is what makes a reload safe.
+ */
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { sessionFileAddress } from '@deepseek-ai/dsh-util-workspace-path'
+import { SidebarRightTabRegistry } from '@deepseek-ai/dsh-client-ui-sidebar-right/src/client/tab-registry.ts'
+import { BrowserBody } from '../src/client/BrowserBody.tsx'
+import { BROWSER_ID, BROWSER_KIND } from '../src/client/definition.tsx'
+import { apply, inject, PreviewSiteError } from '../src/client/index.ts'
+import { en, zh } from '../src/client/locales.ts'
+
+interface Recorded {
+  name: string
+  key: string
+  locale: string | undefined
+  store: unknown
+  inject: (() => { requestSite?: unknown }) | undefined
+  component: unknown
+}
+
+async function boot() {
+  const ctx = new Context()
+  const tabs = new SidebarRightTabRegistry(ctx)
+  const registered: Recorded[] = []
+  const slots = {
+    inject: vi.fn((_name: string, register: () => () => void) => register()),
+    register: vi.fn((options: Omit<Recorded, 'component'>, component: unknown) => {
+      const entry: Recorded = { ...options, component }
+      registered.push(entry)
+      return () => { registered.splice(registered.indexOf(entry), 1) }
+    }),
+  }
+  const dictionaries = new Map<string, unknown>()
+  const locale = {
+    // Copy is the dictionary's contract; the key stands in for the translation.
+    bind: vi.fn(() => (key: string) => key),
+    register: vi.fn((ns: string, dicts: unknown) => {
+      dictionaries.set(ns, dicts)
+      return () => { dictionaries.delete(ns) }
+    }),
+  }
+  const call = vi.fn().mockResolvedValue({
+    ok: true,
+    value: { url: '/deepviewer-preview-static/token/index.html', expiresAt: 1, entryPath: 'pages/index.html' },
+  })
+  ctx.provide('sidebarRightTabs', tabs as never)
+  ctx.provide('slots', slots as never)
+  ctx.provide('locale', locale as never)
+  ctx.provide('connection', { rpc: { call } } as never)
+  const fiber = ctx.plugin({ inject: [...inject], apply })
+  await fiber.await()
+  return { call, tabs, registered, dictionaries, fiber }
+}
+
+/** The bound Remote call off the single recorded body registration. */
+function boundRequestSite(registered: Recorded[]): (path: string, signal: AbortSignal) => Promise<unknown> {
+  return registered[0]?.inject?.().requestSite as (path: string, signal: AbortSignal) => Promise<unknown>
+}
+
+describe('ui-sidebar-browser apply', () => {
+  it('registers the type, its dictionaries, and the body seat under the type\'s id', async () => {
+    const { tabs, registered, dictionaries } = await boot()
+    const definition = tabs.get(BROWSER_KIND)
+    expect(definition?.id).toBe(BROWSER_ID)
+    expect(definition?.priority).toBe('builtin')
+    expect(definition?.title('sidebar://browser')).toBe('type.label')
+    expect(definition?.guide?.map(entry => [entry.order, entry.title(), entry.description?.()]))
+      .toEqual([[20, 'guide.title', 'guide.description']])
+    expect(dictionaries.get('sidebarBrowser')).toEqual({ zh, en })
+    // The seat key is the implementation's id, not the kind: an extension may
+    // take the kind over, and the seat must still find this body.
+    expect(registered.map(entry => [entry.name, entry.key, entry.locale, entry.component])).toEqual([
+      ['sidebar.right.pane.tab', BROWSER_ID, 'sidebarBrowser', BrowserBody],
+    ])
+    expect(registered[0]?.store).toBeDefined()
+    expect(typeof boundRequestSite(registered)).toBe('function')
+  })
+
+  it('routes an HTML file address to the browser and every other file to the plain viewer', async () => {
+    const { tabs } = await boot()
+    tabs.register({
+      id: 'text-viewer', kind: 'text', patterns: ['dsh-resource://file/**'],
+      priority: 'fallback', title: (address: string) => address,
+    })
+    expect(tabs.claim(sessionFileAddress('s-1', '/w/page.html')).kind).toBe(BROWSER_KIND)
+    expect(tabs.claim(sessionFileAddress('s-1', '/w/notes.md')).kind).toBe('text')
+  })
+
+  it('mints through the Connection carrier with the absolute entry path', async () => {
+    const { call, registered } = await boot()
+    const signal = new AbortController().signal
+    await expect(boundRequestSite(registered)('/w/pages/index.html', signal)).resolves.toEqual({
+      url: '/deepviewer-preview-static/token/index.html', expiresAt: 1, entryPath: 'pages/index.html',
+    })
+    expect(call).toHaveBeenCalledWith(
+      '/deepviewer-preview', 'site', { absolutePath: '/w/pages/index.html' }, signal,
+    )
+  })
+
+  it('keeps the host\'s failure code when a mint is refused', async () => {
+    const { call, registered } = await boot()
+    call.mockResolvedValueOnce({
+      ok: false, error: { code: 'outside-workspace', message: 'No workspace contains this file.' },
+    })
+    const rejection = await boundRequestSite(registered)('/elsewhere/index.html', new AbortController().signal)
+      .then(() => undefined, (error: unknown) => error)
+    expect(rejection).toBeInstanceOf(PreviewSiteError)
+    expect((rejection as PreviewSiteError).code).toBe('outside-workspace')
+  })
+
+  it('takes every registration back when the plugin is disposed', async () => {
+    const { tabs, registered, dictionaries, fiber } = await boot()
+    await fiber.dispose()
+    expect(tabs.get(BROWSER_KIND)).toBeUndefined()
+    expect(registered).toEqual([])
+    expect(dictionaries.size).toBe(0)
+  })
+})
