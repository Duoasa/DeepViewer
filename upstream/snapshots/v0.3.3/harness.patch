@@ -0,0 +1,83 @@
+/**
+ * Browser half: register `browser` as a right-Sidebar tab type.
+ *
+ * The public two-stage path, unmodified: the type into `ctx.sidebarRightTabs`,
+ * and the body into the keyed `sidebar.right.pane.tab` seat under the type's
+ * `id`. What the type claims is stage one's business (`definition.tsx`): a page
+ * the guide offers, plus every `.html` file address in the workspace.
+ *
+ * The file split is this package's layering: what the type IS
+ * (`definition.tsx`), what it keeps (`store.ts`), what it draws
+ * (`BrowserBody.tsx`), how it addresses a served page (`site-url.ts`), what it
+ * says (`locales.ts`), and this module, which only wires them together.
+ */
+import type { Context as ClientContext } from '@deepseek-ai/cordis'
+import type { ConnectionHandle } from '@deepseek-ai/dsh-client-connection/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type {} from '@deepseek-ai/dsh-client-ui-session/client'
+import type {} from '@deepseek-ai/dsh-client-ui-sidebar-right/client'
+import { BROWSER_ID, browserDefinition } from './definition.tsx'
+import { BrowserBody } from './BrowserBody.tsx'
+import type { BrowserInjected, RequestPreviewSite } from './BrowserBody.tsx'
+import { PREVIEW_RPC_CHANNEL, PreviewSiteError } from './site-url.ts'
+import type { PreviewSite } from './site-url.ts'
+import { en, zh } from './locales.ts'
+import { createBrowserStore } from './store.ts'
+
+export type { SidebarBrowserKey } from './locales.ts'
+export type { BrowserFileBinding, BrowserState, BrowserTabState } from './store.ts'
+export type { BrowserBodyProps, BrowserInjected, RequestPreviewSite } from './BrowserBody.tsx'
+export {
+  absoluteEntryOf,
+  absolutePathFor,
+  assetPathOf,
+  displayPathOf,
+  normalizeAddress,
+  parsePreviewBrowserLocation,
+  PREVIEW_RPC_CHANNEL,
+  PREVIEW_STATIC_PREFIX,
+  PreviewSiteError,
+  resolvesInWorkspace,
+} from './site-url.ts'
+export type { PreviewBrowserLocation, PreviewSite } from './site-url.ts'
+export { BROWSER_ID, BROWSER_KIND, browserDefinition, browserTitle, isHtmlFileAddress } from './definition.tsx'
+
+/** This package's copy namespace. */
+const NS = 'sidebarBrowser'
+
+/**
+ * Required browser services: the keyed seat, copy, the tab registry, and the
+ * Connection carrier behind the capability call.
+ */
+export const inject = ['slots', 'locale', 'sidebarRightTabs', 'connection']
+
+/**
+ * Client plugin body: register the type, its dictionaries, and its body.
+ * @param ctx - client root context carrying the registry, the slots, and copy.
+ */
+export function apply(ctx: ClientContext): void {
+  const t = ctx.locale.bind(NS)
+  ctx.effect(() => ctx.sidebarRightTabs.register(browserDefinition(t)), 'ui-sidebar-browser: browser type')
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'ui-sidebar-browser: dictionaries')
+
+  const connection = ctx.get('connection') as ConnectionHandle
+  const requestSite: RequestPreviewSite = async (absolutePath, signal) => {
+    const result = await connection.rpc.call(PREVIEW_RPC_CHANNEL, 'site', { absolutePath }, signal)
+    // The code survives so the body can translate the failures worth
+    // explaining and still show the host's own message for the rest.
+    if (!result.ok) throw new PreviewSiteError(result.error.code, result.error.message)
+    return result.value as PreviewSite
+  }
+
+  const store = createBrowserStore()
+  ctx.effect(() => ctx.slots.inject('sidebar.right.pane.tab', () => ctx.slots.register(
+    {
+      name: 'sidebar.right.pane.tab',
+      key: BROWSER_ID,
+      locale: NS,
+      store,
+      inject: (): BrowserInjected => ({ requestSite }),
+    },
+    BrowserBody,
+  )), 'ui-sidebar-browser: browser tab body')
+}
