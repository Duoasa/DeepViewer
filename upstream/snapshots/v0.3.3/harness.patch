index 0000000000000000000000000000000000000000..4a5f3fbb2291ed5a291e66b9bc7c728ade953f06
--- /dev/null
+++ b/packages/host/preview-static/tests/workspace-resolution.host.spec.ts
@@ -0,0 +1,48 @@
+/**
+ * Workspace resolution for one absolute file path.
+ *
+ * The browser half cannot name a workspace — a Session address carries a path
+ * relative to the Session cwd, and a Session may sit *below* the workspace it
+ * belongs to — so this decision lives here, where every registered root is
+ * visible at once. Membership by `sessionIds` is deliberately not consulted,
+ * which is what these cases pin down.
+ */
+import { describe, expect, it } from 'vitest'
+import { containingWorkspace } from '../src/index.ts'
+
+const WORKSPACES = [
+  { path: '/Users/me/work' },
+  { path: '/Users/me/work/apps/site' },
+]
+
+describe('containingWorkspace', () => {
+  it('picks the tightest root when workspaces nest', () => {
+    expect(containingWorkspace(WORKSPACES, '/Users/me/work/apps/site/pages/index.html'))
+      .toEqual({ root: '/Users/me/work/apps/site', relativePath: 'pages/index.html' })
+    expect(containingWorkspace(WORKSPACES, '/Users/me/work/notes/readme.html'))
+      .toEqual({ root: '/Users/me/work', relativePath: 'notes/readme.html' })
+  })
+
+  it('resolves a file below the workspace in a directory no Session is accounted to', () => {
+    // The shape that broke the first cut: the Session cwd is `work/111/test`,
+    // which equals no registered root, yet `work` still contains the file.
+    expect(containingWorkspace(WORKSPACES, '/Users/me/work/111/test/about-me.html'))
+      .toEqual({ root: '/Users/me/work', relativePath: '111/test/about-me.html' })
+  })
+
+  it('requires a path boundary, not a shared prefix', () => {
+    expect(containingWorkspace(WORKSPACES, '/Users/me/workbench/index.html')).toBeUndefined()
+    expect(containingWorkspace(WORKSPACES, '/Users/me/work')).toBeUndefined()
+  })
+
+  it('answers nothing when no workspace contains the file', () => {
+    expect(containingWorkspace(WORKSPACES, '/etc/hosts')).toBeUndefined()
+    expect(containingWorkspace([], '/Users/me/work/index.html')).toBeUndefined()
+  })
+
+  it('normalizes separators and trailing slashes on both sides', () => {
+    expect(containingWorkspace([{ path: '/Users/me/work/' }], '\\Users\\me\\work\\index.html'))
+      .toEqual({ root: '/Users/me/work', relativePath: 'index.html' })
+    expect(containingWorkspace([{ path: '' }], '/Users/me/work/index.html')).toBeUndefined()
+  })
+})
