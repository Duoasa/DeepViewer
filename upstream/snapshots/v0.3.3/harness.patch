+/* DeepViewer override:start hide-empty-hero-branding */
+/* The welcome occupies the space above the bottom composer. Its top padding
+   equals the workspace-row prelude inside the composer, so the visible module
+   centers between the window top and the input card top rather than the
+   composer seat's outer edge. */
+.root {
+  position: relative;
+  inset: auto;
+  flex: 1 1 auto;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-sizing: border-box;
+  height: auto;
+  min-width: 0;
+  min-height: 0;
+  padding: var(--deepviewer-hero-input-prelude-height) 24px 0;
+  pointer-events: none;
+}
+
+.stack {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 40px;
+  width: 100%;
+}
+
+.logo {
+  display: block;
+  width: auto;
+  height: 48px;
+  flex: none;
+  overflow: visible;
+  color: var(--dsw-alias-label-primary);
+  opacity: 0.5;
+}
+
+.logoCursor {
+  animation: deepviewer-hero-cursor-blink 1s steps(1, jump-end) infinite;
+}
+
+.prompt {
+  margin: 0;
+  color: var(--dsw-alias-label-primary);
+  font-family: var(--dsw-font-family);
+  font-size: 24px;
+  font-weight: 400;
+  line-height: 32px;
+  opacity: 0.5;
+  text-align: center;
+}
+
+@keyframes deepviewer-hero-cursor-blink {
+  0%,
+  49% {
+    opacity: 1;
+  }
+
+  50%,
+  100% {
+    opacity: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .logoCursor {
+    animation: none;
+  }
+}
+/* DeepViewer override:end hide-empty-hero-branding */
