+ * `sidebarBrowser` namespace dictionaries, and the namespace's declaration.
+ *
+ * The namespace merge lives with its key set so that any module naming
+ * `TranslateNS<'sidebarBrowser'>` or `PropsLocale<'sidebarBrowser'>` needs only
+ * this file, whichever entry a program loads first.
+ */
+import type {} from '@deepseek-ai/dsh-client-ui-slots'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** Browser type name, guide entry, address bar, and empty state. */
+    sidebarBrowser: SidebarBrowserKey
+  }
+}
+
+/** Simplified Chinese dictionary and key-set source of truth. */
+export const zh = {
+  'type.label': '浏览器',
+  'guide.title': '浏览器',
+  'guide.description': '在右侧栏中预览任意网页',
+  'address.placeholder': '输入网址,回车访问',
+  visit: '访问',
+  reload: '重新加载',
+  empty: '在上方输入网址,即可在这里预览网页',
+  'frame.title': '网页预览',
+  'file.address': '输入工作区内的 .html 相对路径,或任意网址',
+  'file.opening': '正在打开页面…',
+  'file.noWorkspace': '此文件不在任何已注册的工作区中,浏览器无法预览',
+  'file.notLoopback': '静态预览路由只在回环绑定下可用',
+} satisfies Record<string, string>
+
+/** Browser dictionary key union. */
+export type SidebarBrowserKey = keyof typeof zh
+
+/** English dictionary, checked against the Chinese key set. */
+export const en = {
+  'type.label': 'Browser',
+  'guide.title': 'Browser',
+  'guide.description': 'Preview any web page in the right Sidebar',
+  'address.placeholder': 'Enter a URL and press Enter',
+  visit: 'Visit',
+  reload: 'Reload',
+  empty: 'Enter a URL above to preview a page here',
+  'frame.title': 'Web page preview',
+  'file.address': 'Enter a workspace-relative .html path, or any URL',
+  'file.opening': 'Opening the page…',
+  'file.noWorkspace': 'This file is not inside any registered workspace, so the browser cannot preview it',
+  'file.notLoopback': 'The static preview route is only available on a loopback bind',
+} satisfies Record<SidebarBrowserKey, string>
