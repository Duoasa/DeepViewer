@@ -0,0 +1,61 @@
+export const NS = 'deepviewer.preview'
+
+export const zh = {
+  title: '预览',
+  open: '打开预览',
+  toggle: '切换预览侧栏',
+  code: '代码',
+  web: '网页',
+  refresh: '刷新预览',
+  back: '后退',
+  forward: '前进',
+  reloadPage: '重新载入网页',
+  address: '预览地址',
+  addressHint: '仅可打开当前预览站点内的地址',
+  openExternal: '在系统浏览器中打开',
+  webPreview: '网页预览',
+  files: '工作区文件',
+  collapseFiles: '收起工作区文件',
+  expandFiles: '展开工作区文件',
+  resizeSections: '拖动调整工作区文件与预览区高度',
