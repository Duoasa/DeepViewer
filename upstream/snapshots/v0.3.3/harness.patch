+/** Address arithmetic: the absolute entry rebuilt from a Session address, what the framed URL shows, and what a typed address resolves to. */
+import { describe, expect, it } from 'vitest'
+import {
+  absoluteEntryOf,
+  absolutePathFor,
+  assetPathOf,
+  displayPathOf,
+  normalizeAddress,
+  parsePreviewBrowserLocation,
+  PREVIEW_BROWSER_MESSAGE_SOURCE,
+  resolvesInWorkspace,
+} from '../src/client/site-url.ts'
+
+describe('preview browser locations', () => {
+  it('accepts this bridge\'s report and nothing else', () => {
+    expect(parsePreviewBrowserLocation({
+      source: PREVIEW_BROWSER_MESSAGE_SOURCE, type: 'location', href: 'http://x/a', title: 'A',
+    })).toEqual({ href: 'http://x/a', title: 'A' })
+    expect(parsePreviewBrowserLocation({ source: 'other', type: 'location', href: 'http://x/a', title: 'A' })).toBeUndefined()
+    expect(parsePreviewBrowserLocation({ source: PREVIEW_BROWSER_MESSAGE_SOURCE, type: 'command' })).toBeUndefined()
+    expect(parsePreviewBrowserLocation({ source: PREVIEW_BROWSER_MESSAGE_SOURCE, type: 'location', href: 1, title: 'A' })).toBeUndefined()
+    expect(parsePreviewBrowserLocation(null)).toBeUndefined()
+    expect(parsePreviewBrowserLocation('deepviewer')).toBeUndefined()
+  })
+})
+
+describe('the absolute entry behind a Session address', () => {
+  // The regression this guards: `fileAddressFor` relativizes a path against the
+  // Session cwd, so an address under the cwd carries `about-me.html`, never
+  // `/Users/…/about-me.html`. Treating it as absolute is what made every HTML
+  // preview report "no path".
+  it('anchors a cwd-relative address path on the Session cwd', () => {
+    expect(absoluteEntryOf('about-me.html', '/Users/me/work')).toBe('/Users/me/work/about-me.html')
+    expect(absoluteEntryOf('pages/index.html', '/Users/me/work/')).toBe('/Users/me/work/pages/index.html')
+  })
+
+  it('passes an already-absolute address path through', () => {
+    expect(absoluteEntryOf('/etc/hosts.html', '/Users/me/work')).toBe('/etc/hosts.html')
+    expect(absoluteEntryOf('/etc/hosts.html', undefined)).toBe('/etc/hosts.html')
+    expect(absoluteEntryOf('C:/w/x.html', undefined)).toBe('C:/w/x.html')
+    expect(absoluteEntryOf('//server/share/x.html', undefined)).toBe('//server/share/x.html')
+  })
+
+  it('cannot resolve a relative path without a Session root', () => {
+    expect(absoluteEntryOf('about-me.html', undefined)).toBeUndefined()
+    expect(absoluteEntryOf('about-me.html', '')).toBeUndefined()
+    expect(absoluteEntryOf('', '')).toBeUndefined()
+  })
+
+  it('treats an empty relative path as the root itself', () => {
+    expect(absoluteEntryOf('', '/Users/me/work')).toBe('/Users/me/work')
+  })
+})
+
+describe('capability URLs', () => {
+  it('reads the asset path below the token', () => {
+    expect(assetPathOf('/deepviewer-preview-static/tok/index.html')).toBe('index.html')
+    expect(assetPathOf('http://127.0.0.1:1/deepviewer-preview-static/tok/a/b%20c.css')).toBe('a/b c.css')
+    expect(assetPathOf('/deepviewer-preview-static/tok')).toBeUndefined()
+    expect(assetPathOf('/deepviewer-preview-static')).toBeUndefined()
+    expect(assetPathOf('/somewhere/else/index.html')).toBeUndefined()
+    expect(assetPathOf('not a url at all')).toBeUndefined()
+  })
+
+  it('re-anchors the framed asset under the entry\'s own directory', () => {
+    expect(displayPathOf('/deepviewer-preview-static/tok/index.html', 'pages/index.html')).toBe('pages/index.html')
+    expect(displayPathOf('/deepviewer-preview-static/tok/style.css', 'pages/index.html')).toBe('pages/style.css')
+    expect(displayPathOf('/deepviewer-preview-static/tok/nested/app.js', 'index.html')).toBe('nested/app.js')
+    expect(displayPathOf('/elsewhere/index.html', 'pages/index.html')).toBeUndefined()
+  })
+})
+
+describe('typed addresses', () => {
+  it('resolves a relative path against the entry\'s own directory', () => {
+    expect(absolutePathFor('/w/pages/index.html', 'other.html')).toBe('/w/pages/other.html')
+    expect(absolutePathFor('/w/pages/deep/index.html', '../other.html')).toBe('/w/pages/other.html')
+    expect(absolutePathFor('/w/index.html', 'app/main.html')).toBe('/w/app/main.html')
+    expect(absolutePathFor('/w/index.html', 'index.html?v=2#top')).toBe('/w/index.html')
+  })
+
+  it('refuses an absolute path, another origin, or a climb above the filesystem root', () => {
+    expect(absolutePathFor('/w/index.html', '')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', '/etc/passwd')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', 'C:\\secrets.html')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', 'back\\slash.html')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', 'https://example.com/index.html')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', '../../../outside.html')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', '..')).toBeUndefined()
+    expect(absolutePathFor('/w/index.html', '..\\..\\outside.html')).toBeUndefined()
+  })
+
+  it('may climb to a sibling directory, which the host re-checks against the workspace', () => {
+    expect(absolutePathFor('/w/pages/deep/index.html', '../../index.html')).toBe('/w/index.html')
+  })
+})
+
+describe('what the bar\'s text means', () => {
+  it('normalizes a typed address', () => {
+    expect(normalizeAddress('  https://example.com  ')).toBe('https://example.com')
+    expect(normalizeAddress('example.com')).toBe('https://example.com')
+    expect(normalizeAddress('localhost:5173')).toBe('http://localhost:5173')
+    expect(normalizeAddress('127.0.0.1:8080/app')).toBe('http://127.0.0.1:8080/app')
+    expect(normalizeAddress('   ')).toBeUndefined()
+  })
+
+  // The regression this guards: a file tab used to refuse every address, so the
+  // browser a workspace page opened in could not reach the open web at all.
+  it('keeps an address an address, even inside a file tab', () => {
+    expect(resolvesInWorkspace('https://example.com')).toBe(false)
+    expect(resolvesInWorkspace('http://localhost:5173')).toBe(false)
+    expect(resolvesInWorkspace('localhost:5173')).toBe(false)
+    expect(resolvesInWorkspace('127.0.0.1:8080/x.html')).toBe(false)
+    expect(resolvesInWorkspace('example.com')).toBe(false)
+    expect(resolvesInWorkspace('example.com/page.html')).toBe(false)
+    expect(resolvesInWorkspace('/etc/passwd')).toBe(false)
+    expect(resolvesInWorkspace('back\\slash.html')).toBe(false)
+    expect(resolvesInWorkspace('')).toBe(false)
+  })
+
+  it('recognizes a workspace page by its own suffix', () => {
+    expect(resolvesInWorkspace('other.html')).toBe(true)
+    expect(resolvesInWorkspace('./other.html')).toBe(true)
+    expect(resolvesInWorkspace('pages/deep/index.html')).toBe(true)
+    expect(resolvesInWorkspace('../sibling.htm')).toBe(true)
+    expect(resolvesInWorkspace('index.html?v=2#top')).toBe(true)
+    expect(resolvesInWorkspace('INDEX.HTML')).toBe(true)
+    // Not an HTML entry, so it is read as an address — exactly as a browser would.
+    expect(resolvesInWorkspace('notes.md')).toBe(false)
+  })
+
+  it('reads a dotted first segment as a host, not a directory', () => {
+    expect(resolvesInWorkspace('example.com/page.html')).toBe(false)
+    expect(resolvesInWorkspace('docs.example.com/a/b.htm')).toBe(false)
+    // The cost of that rule, pinned so it is a known trade rather than a surprise.
+    expect(resolvesInWorkspace('v1.2/index.html')).toBe(false)
+  })
+})
diff --git a/packages/client/ui-sidebar-browser/tests/store.client.spec.ts b/packages/client/ui-sidebar-browser/tests/store.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..06bc0650f7badb67d3ea9469106ba15d61253427
--- /dev/null
+++ b/packages/client/ui-sidebar-browser/tests/store.client.spec.ts
@@ -0,0 +1,134 @@
+/**
+ * The tab's write set, one tab at a time.
+ *
+ * Two facts here are load-bearing for the body: a lazily-created bucket starts
+ * as an empty, unvisited bar, and the two modes write different pairs — a page
+ * tab echoes its URL into the bar, while a file tab shows the entry's
+ * workspace-relative path and keeps the capability URL only for the frame.
+ */
+import { describe, expect, it } from 'vitest'
+import { createBrowserStore } from '../src/client/store.ts'
+
+const TAB = 'tab-1'
+const OTHER_TAB = 'tab-2'
+
+/** A fresh bucket, as every assertion against an untouched tab spells it. */
+const EMPTY = { draft: '', committed: undefined, nonce: 0, file: undefined, failure: undefined }
+
+describe('createBrowserStore', () => {
+  it('mints an independent instance per call', () => {
+    const first = createBrowserStore().create()
+    const second = createBrowserStore().create()
+    first.actions.setDraft(TAB, 'https://example.com')
+    expect(second.getSnapshot().byTab[TAB]).toBeUndefined()
+  })
+
+  it('starts with no buckets until the first write', () => {
+    const store = createBrowserStore().create()
+    expect(store.getSnapshot().byTab).toEqual({})
+  })
+
+  it('setDraft creates a bucket lazily and keeps the bar text without committing a URL', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.setDraft(TAB, 'example.com')
+    expect(getSnapshot().byTab[TAB]).toEqual({ ...EMPTY, draft: 'example.com' })
+  })
+
+  it('navigate sets both the draft and the committed URL', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.setDraft(TAB, 'example.com')
+    actions.navigate(TAB, 'https://example.com')
+    expect(getSnapshot().byTab[TAB]).toEqual({
+      ...EMPTY, draft: 'https://example.com', committed: 'https://example.com',
+    })
+  })
+
+  it('openFile shows the entry path while the frame gets the capability URL', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    const binding = { absolutePath: '/w/pages/index.html', entryPath: 'pages/index.html' }
+    actions.openFile(TAB, binding, '/deepviewer-preview-static/tok/index.html')
+    expect(getSnapshot().byTab[TAB]).toEqual({
+      draft: 'pages/index.html',
+      committed: '/deepviewer-preview-static/tok/index.html',
+      nonce: 1,
+      file: binding,
+      failure: undefined,
+    })
+  })
+
+  it('openFile raises the nonce so a reload at the same URL still remounts', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    const binding = { absolutePath: '/w/index.html', entryPath: 'index.html' }
+    actions.openFile(TAB, binding, '/deepviewer-preview-static/a/index.html')
+    actions.openFile(TAB, binding, '/deepviewer-preview-static/b/index.html')
+    expect(getSnapshot().byTab[TAB]?.nonce).toBe(2)
+  })
+
+  it('a typed address leaves file mode behind', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.openFile(TAB, { absolutePath: '/w/index.html', entryPath: 'index.html' }, '/deepviewer-preview-static/tok/index.html')
+    actions.navigate(TAB, 'https://example.com')
+    // The nonce is a monotonic reload counter, so it survives the mode change.
+    expect(getSnapshot().byTab[TAB]).toEqual({
+      ...EMPTY, draft: 'https://example.com', committed: 'https://example.com', nonce: 1,
+    })
+  })
+
+  it('a successful mint clears the previous failure', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.fail(TAB, 'No workspace contains this file.')
+    expect(getSnapshot().byTab[TAB]?.failure).toBe('No workspace contains this file.')
+    actions.openFile(TAB, { absolutePath: '/w/index.html', entryPath: 'index.html' }, '/deepviewer-preview-static/tok/index.html')
+    expect(getSnapshot().byTab[TAB]?.failure).toBeUndefined()
+  })
+
+  it('reload increments the nonce without touching the URL', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.navigate(TAB, 'https://example.com')
+    actions.reload(TAB)
+    actions.reload(TAB)
+    expect(getSnapshot().byTab[TAB]).toEqual({
+      ...EMPTY, draft: 'https://example.com', committed: 'https://example.com', nonce: 2,
+    })
+  })
+
+  it('reload on an untouched tab creates a bucket at nonce 1', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.reload(TAB)
+    expect(getSnapshot().byTab[TAB]).toEqual({ ...EMPTY, nonce: 1 })
+  })
+
+  it('two tabs navigate independently', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.navigate(TAB, 'https://one.example')
+    actions.navigate(OTHER_TAB, 'https://two.example')
+    expect(getSnapshot().byTab[TAB]?.committed).toBe('https://one.example')
+    expect(getSnapshot().byTab[OTHER_TAB]?.committed).toBe('https://two.example')
+  })
+
+  it('forget removes exactly the tab that went away', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.navigate(TAB, 'https://one.example')
+    actions.navigate(OTHER_TAB, 'https://two.example')
+    actions.forget(TAB)
+    expect(Object.keys(getSnapshot().byTab)).toEqual([OTHER_TAB])
+  })
+
+  it('forget on a tab with no bucket is a no-op', () => {
+    const store = createBrowserStore().create()
+    const { actions, getSnapshot } = store
+    actions.navigate(OTHER_TAB, 'https://two.example')
+    actions.forget(TAB)
+    expect(Object.keys(getSnapshot().byTab)).toEqual([OTHER_TAB])
+  })
+})
