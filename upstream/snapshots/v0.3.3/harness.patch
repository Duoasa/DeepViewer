--- /dev/null
+++ b/packages/host/preview-static/src/index.ts
@@ -0,0 +1,216 @@
+/**
+ * @deepseek-ai/dsh-host-preview-static — the host half behind the right
+ * Sidebar's browser preview of a workspace page.
+ *
+ * The browser tab cannot load `dsh-resource://file/**`: an iframe needs an
+ * HTTP URL, and a blob URL cuts the page off from its own relative assets. So
+ * this plugin lends the workspace a real origin. It mints a short-lived,
+ * unguessable capability for one HTML entry, then serves that entry and its
+ * sibling files under `/deepviewer-preview-static/<token>/…`, with every
+ * request contained to the entry's own directory.
+ *
+ * Two seats, one capability table:
+ * - the `site` RPC on `/deepviewer-preview` mints a capability and answers the
+ *   URL the browser tab should frame;
+ * - the `/deepviewer-preview-static` prefix route serves the assets, and only
+ *   for a token the table still holds.
+ *
+ * The route is deliberately mounted only on a loopback bind: on an
+ * all-interfaces bind the capability would be the *only* thing between a LAN
+ * peer and the user's workspace, so the plugin withholds the route and the RPC
+ * reports why. The route also bypasses Connection's browser authentication on
+ * purpose — the framed document runs in an opaque origin, so it carries no
+ * session cookie — which is exactly what the token is for.
+ * @module @deepseek-ai/dsh-host-preview-static
+ */
+
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import type { Context } from '@deepseek-ai/cordis'
+import type { ConnectionRpcResult } from '@deepseek-ai/dsh-client-connection'
+import type {} from '@deepseek-ai/dsh-client-connection'
+import type { WebRoute } from '@deepseek-ai/dsh-host-webserver'
+import type {} from '@deepseek-ai/dsh-workspace'
+import {
+  endWithStatus,
+  PreviewCapabilities,
+  readAsset,
+  resolveCapabilityAsset,
+  securityHeaders,
+} from './capability.ts'
+
+/** Stable Cordis plugin name. */
+export const name = 'preview-static'
+
+/** Services required before either seat can be claimed. */
+export const inject = ['webServer', 'connection', 'workspaceRegistry']
+
+/** Logical RPC channel the browser tab mints capabilities on. */
+export const PREVIEW_RPC_CHANNEL = '/deepviewer-preview'
+
+/** HTTP prefix the capability tokens hang under. */
+export const PREVIEW_STATIC_PREFIX = '/deepviewer-preview-static'
+
+/** What the browser tab sends to mint a capability. */
+interface SiteRequest {
+  /**
+   * Absolute path of the entry.
+   *
+   * Absolute, not workspace-relative, because the browser half cannot name a
+   * workspace reliably: a `dsh-resource://file/session/…` address carries a
+   * path relative to the *Session's* cwd, and a Session may sit below the
+   * workspace it belongs to, so resolving the workspace from the address alone
+   * picks the wrong record. The browser half resolves the address against the
+   * Session cwd it does hold, and this plugin owns the workspace decision.
+   */
+  readonly absolutePath: string
+}
+
+/** One minted capability, as the browser tab receives it. */
+export interface SiteResponse {
+  /** Relative URL of the entry, resolved by the browser against the app origin. */
+  readonly url: string
+  /** Epoch milliseconds after which the URL stops working. */
+  readonly expiresAt: number
+  /**
+   * The entry's path relative to the workspace that contains it.
+   *
+   * Returned so the browser half can show and navigate a path without knowing
+   * any workspace at all — the only root it needs is the entry's directory,
+   * which this value already carries.
+   */
+  readonly entryPath: string
+}
+
+/**
+ * Validate the RPC payload.
+ * @param payload - the decoded request body.
+ * @returns the parsed request.
+ * @throws {Error} when the field is missing or ill-typed.
+ */
+function parseSiteRequest(payload: unknown): SiteRequest {
+  if (typeof payload !== 'object' || payload === null) throw new Error('preview request must be an object')
+  const value = payload as Partial<SiteRequest>
+  if (typeof value.absolutePath !== 'string' || value.absolutePath === '') {
+    throw new Error('preview request requires absolutePath')
+  }
+  return { absolutePath: value.absolutePath }
+}
+
+/** Normalize a path for prefix comparison: POSIX separators, no trailing slash. */
+function normalizedRoot(path: string): string {
+  return path.replaceAll('\\', '/').replace(/\/+$/u, '')
+}
+
+/**
+ * Find the workspace whose root contains a file, tightest first.
+ *
+ * The longest matching root wins, so nested workspaces cannot be confused for
+ * one another. Membership by `sessionIds` is deliberately not consulted: that
+ * account is validated against a Session's cwd, which need not equal — or even
+ * sit directly under — the workspace root.
+ * @param workspaces - every registered workspace.
+ * @param absolutePath - the file's absolute path.
+ * @returns the containing workspace and the file's path relative to it, or undefined when none contains it.
+ */
+export function containingWorkspace(
+  workspaces: readonly { readonly path: string }[],
+  absolutePath: string,
+): { readonly root: string, readonly relativePath: string } | undefined {
+  const target = absolutePath.replaceAll('\\', '/')
+  let best: { root: string, relativePath: string } | undefined
+  for (const workspace of workspaces) {
+    const root = normalizedRoot(workspace.path)
+    if (root === '' || !target.startsWith(`${root}/`)) continue
+    if (best !== undefined && root.length <= best.root.length) continue
+    best = { root, relativePath: target.slice(root.length + 1) }
+  }
+  return best
+}
+
+/** One RPC failure in the Connection envelope. */
+function failure(code: string, message: string, details: object = {}): ConnectionRpcResult<never> {
+  return { ok: false, error: { code, message, details } }
+}
+
+/**
+ * Mount the capability RPC and the token-gated static route.
+ * @param ctx - host context carrying the webserver, Connection, and the workspace registry.
+ */
+export function apply(ctx: Context): void {
+  const capabilities = new PreviewCapabilities()
+  const loopback = ctx.webServer.host === '127.0.0.1'
+
+  ctx.effect(() => ctx.connection.rpc.handle(PREVIEW_RPC_CHANNEL, async (endpoint, payload) => {
+    if (endpoint !== 'site') return failure('bad-request', `Unknown preview endpoint: ${endpoint}`)
+    if (!loopback) {
+      return failure(
+        'not-loopback',
+        'The static preview route is only mounted on a loopback bind.',
+        { host: ctx.webServer.host },
+      )
+    }
+    let request: SiteRequest
+    try {
+      request = parseSiteRequest(payload)
+    } catch (error) {
+      return failure('bad-request', error instanceof Error ? error.message : 'invalid preview request')
+    }
+    const contained = containingWorkspace(ctx.workspaceRegistry.list(), request.absolutePath)
+    if (contained === undefined) {
+      return failure('outside-workspace', 'No workspace contains this file.', {
+        absolutePath: request.absolutePath,
+      })
+    }
+    try {
+      const capability = await capabilities.create(contained.root, contained.relativePath)
+      const entry = encodeURIComponent(capability.entry)
+      return {
+        ok: true,
+        value: {
+          url: `${PREVIEW_STATIC_PREFIX}/${capability.token}/${entry}`,
+          expiresAt: capability.expiresAt,
+          entryPath: contained.relativePath,
+        } satisfies SiteResponse,
+      }
+    } catch (error) {
+      return failure('internal', error instanceof Error ? error.message : 'Preview request failed.')
+    }
+  }), 'preview-static: capability RPC')
+
+  if (!loopback) return
+
+  ctx.effect(() => ctx.webServer.register({
+    kind: 'prefix',
+    path: PREVIEW_STATIC_PREFIX,
+    handler: async (req: IncomingMessage, res: ServerResponse) => {
+      if (req.method !== 'GET' && req.method !== 'HEAD') {
+        res.writeHead(405, { Allow: 'GET, HEAD' })
+        res.end()
+        return
+      }
+      /* v8 ignore next -- node:http always sets url on server requests */
+      const pathname = new URL(req.url ?? '/', 'http://preview.invalid').pathname
+      const suffix = pathname.startsWith(`${PREVIEW_STATIC_PREFIX}/`)
+        ? pathname.slice(PREVIEW_STATIC_PREFIX.length + 1)
+        : ''
+      const slash = suffix.indexOf('/')
+      const token = slash === -1 ? suffix : suffix.slice(0, slash)
+      const assetPath = slash === -1 ? '' : suffix.slice(slash + 1)
+      const capability = capabilities.get(token)
+      if (capability === undefined) {
+        endWithStatus(res, 404)
+        return
+      }
+      try {
+        const asset = await resolveCapabilityAsset(capability, assetPath)
+        const content = await readAsset(asset)
+        res.writeHead(200, securityHeaders(asset.contentType, content.byteLength))
+        if (req.method === 'HEAD') res.end()
+        else res.end(content)
+      } catch {
+        // A miss and a containment rejection are indistinguishable on purpose.
+        endWithStatus(res, 404)
+      }
+    },
+  } satisfies WebRoute), 'preview-static: capability route')
+}
