+        const c = this.claim;
+        return {
+            phase: this.phase,
+            ...(c
+                ? {
+                    claim: {
+                        token: c.token,
+                        ...(c.hint !== undefined ? { hint: c.hint } : {}),
+                        ...(c.attachments === true ? { attachments: true } : {}),
+                    },
+                }
+                : {}),
+        };
+    }
