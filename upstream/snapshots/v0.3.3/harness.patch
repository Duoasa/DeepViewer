@@ -0,0 +1,271 @@
+/**
+ * Capability tokens and containment for the preview static route.
+ *
+ * A capability is minted per previewed HTML entry and pins the directory the
+ * entry lives in: every asset request resolves inside that directory only,
+ * after both a lexical and a `realpath` containment check, so a symlink cannot
+ * walk out of the workspace. Tokens are opaque, expiring, and bounded in
+ * number, so the route is never a general file server.
+ * @module @deepseek-ai/dsh-host-preview-static/capability
+ */
+
+import { randomBytes } from 'node:crypto'
+import { readFile, realpath, stat } from 'node:fs/promises'
+import { basename, dirname, extname, isAbsolute, relative, resolve, sep } from 'node:path'
+import type { ServerResponse } from 'node:http'
+
+/** Capability lifetime: a page reload after this mints a fresh URL. */
+const CAPABILITY_TTL_MS = 30 * 60 * 1000
+
+/** Concurrent capabilities kept before the oldest is evicted. */
+const MAX_CAPABILITIES = 32
+
+/** Largest asset this route will serve. */
+export const MAX_ASSET_BYTES = 16 * 1024 * 1024
+
+/** Names never served, whatever a capability's root holds. */
+const BLOCKED_NAMES = new Set([
+  '.git', '.hg', '.svn', 'node_modules', '.npmrc', '.pypirc',
+  'id_rsa', 'id_ed25519',
+])
+
+/** Extensions never served: key material stays out of the browser. */
+const BLOCKED_EXTENSIONS = new Set(['.key', '.pem', '.p12', '.pfx', '.crt', '.cer'])
+
+/**
+ * Runtime bridge appended to served HTML: reports the frame's location to the
+ * parent and accepts back/forward/reload commands from it. It grants the
+ * sandboxed document no same-origin identity of its own.
+ */
+export const PREVIEW_NAVIGATION_BRIDGE = `<script>(()=>{const s='deepviewer-preview-browser';const report=()=>parent.postMessage({source:s,type:'location',href:location.href,title:document.title},'*');addEventListener('message',event=>{if(event.source!==parent||event.data?.source!==s||event.data?.type!=='command')return;switch(event.data.command){case'back':history.back();break;case'forward':history.forward();break;case'reload':location.reload();break}});addEventListener('pageshow',report);addEventListener('popstate',report);addEventListener('hashchange',report);const push=history.pushState.bind(history);history.pushState=(...args)=>{push(...args);queueMicrotask(report)};const replace=history.replaceState.bind(history);history.replaceState=(...args)=>{replace(...args);queueMicrotask(report)};queueMicrotask(report)})()</script>`
+
+/** One minted capability. */
+export interface StaticCapability {
+  /** Opaque route segment naming this capability. */
+  readonly token: string
+  /** Directory every asset of this capability resolves inside. */
+  readonly root: string
+  /** Entry file name, relative to {@link root}, served at the capability root. */
+  readonly entry: string
+  /** Epoch milliseconds after which the capability is refused. */
+  readonly expiresAt: number
+}
+
+/**
+ * Split a workspace-relative POSIX path.
+ * @param path - the caller's path.
+ * @returns its segments, empty for the workspace root.
+ * @throws {Error} when the path is absolute, escapes, or carries an empty segment.
+ */
+function segments(path: string): string[] {
+  if (path.includes('\\') || path.includes('\0') || isAbsolute(path)) {
+    throw new Error('preview path must be a workspace-relative POSIX path')
+  }
+  const values = path === '' ? [] : path.split('/')
+  if (values.some(value => value === '' || value === '.' || value === '..')) {
+    throw new Error('preview path contains an invalid segment')
+  }
+  return values
+}
+
+/**
+ * Whether a path names something the route must never serve.
+ * @param path - a workspace-relative POSIX path.
+ * @returns true when any segment is blocked.
+ */
+export function isBlockedPreviewPath(path: string): boolean {
+  return segments(path).some((segment) => {
+    const lower = segment.toLowerCase()
+    return BLOCKED_NAMES.has(lower)
+      || lower === '.env'
+      || lower.startsWith('.env.')
+      || BLOCKED_EXTENSIONS.has(extname(lower))
+  })
+}
+
+/** Whether a resolved candidate stays inside its root. */
+function isWithin(root: string, candidate: string): boolean {
+  const fromRoot = relative(root, candidate)
+  return fromRoot === '' || (!fromRoot.startsWith(`..${sep}`) && fromRoot !== '..' && !isAbsolute(fromRoot))
+}
+
+/**
+ * Resolve an existing path only after lexical and `realpath` containment.
+ * @param root - the containing directory.
+ * @param path - a path relative to `root`.
+ * @returns the canonical root and the canonical target.
+ * @throws {Error} on a blocked path, a missing target, or any escape.
+ */
+export async function resolveContainedPath(root: string, path: string): Promise<{ root: string, path: string }> {
+  if (isBlockedPreviewPath(path)) throw new Error('preview access to this path is blocked')
+  const canonicalRoot = await realpath(root)
+  const lexical = resolve(canonicalRoot, ...segments(path))
+  if (!isWithin(canonicalRoot, lexical)) throw new Error('preview path escapes its capability root')
+  const canonical = await realpath(lexical)
+  if (!isWithin(canonicalRoot, canonical)) throw new Error('preview symlink escapes its capability root')
+  return { root: canonicalRoot, path: canonical }
+}
+
+/** Content type for a served asset. */
+export function mimeType(path: string): string {
+  switch (extname(path).toLowerCase()) {
+    case '.css': return 'text/css; charset=utf-8'
+    case '.gif': return 'image/gif'
+    case '.html': case '.htm': return 'text/html; charset=utf-8'
+    case '.ico': return 'image/x-icon'
+    case '.jpeg': case '.jpg': return 'image/jpeg'
+    case '.js': case '.mjs': return 'text/javascript; charset=utf-8'
+    case '.json': case '.map': return 'application/json; charset=utf-8'
+    case '.png': return 'image/png'
+    case '.svg': return 'image/svg+xml'
+    case '.txt': return 'text/plain; charset=utf-8'
+    case '.wasm': return 'application/wasm'
+    case '.webp': return 'image/webp'
+    case '.woff': return 'font/woff'
+    case '.woff2': return 'font/woff2'
+    default: return 'application/octet-stream'
+  }
+}
+
+/**
+ * Response headers for one served asset.
+ *
+ * `frame-ancestors 'self'` lets the Sidebar make the request and refuses every
+ * other embedder; `connect-src 'none'` keeps the sandboxed document from
+ * reaching back into the host's own APIs.
+ * @param contentType - the asset's content type.
+ * @param size - its byte length.
+ * @returns the header set.
+ */
+export function securityHeaders(contentType: string, size: number): Record<string, string | number> {
+  return {
+    'Content-Type': contentType,
+    'Content-Length': size,
+    'Cache-Control': 'no-store',
+    'Content-Security-Policy': "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'",
+    'Cross-Origin-Resource-Policy': 'cross-origin',
+    'Referrer-Policy': 'no-referrer',
+    'X-Content-Type-Options': 'nosniff',
+  }
+}
+
+/**
+ * The capability table: minted on demand, looked up per request, pruned by age.
+ */
+export class PreviewCapabilities {
+  readonly #entries = new Map<string, StaticCapability>()
+
+  /**
+   * Mint a capability for one HTML entry.
+   * @param workspaceRoot - the workspace directory the entry path is relative to.
+   * @param entryPath - the workspace-relative path of the HTML entry.
+   * @param now - epoch milliseconds, injectable for tests.
+   * @returns the minted capability.
+   * @throws {Error} when the entry is blocked, missing, or not an HTML file.
+   */
+  async create(workspaceRoot: string, entryPath: string, now = Date.now()): Promise<StaticCapability> {
+    const target = await resolveContainedPath(workspaceRoot, entryPath)
+    const info = await stat(target.path)
+    if (!info.isFile() || !['.html', '.htm'].includes(extname(target.path).toLowerCase())) {
+      throw new Error('web preview requires an HTML entry file')
+    }
+    this.prune(now)
+    while (this.#entries.size >= MAX_CAPABILITIES) {
+      const oldest = this.#entries.keys().next().value as string | undefined
+      if (oldest === undefined) break
+      this.#entries.delete(oldest)
+    }
+    const capability: StaticCapability = {
+      token: randomBytes(24).toString('base64url'),
+      root: dirname(target.path),
+      entry: basename(target.path),
+      expiresAt: now + CAPABILITY_TTL_MS,
+    }
+    this.#entries.set(capability.token, capability)
+    return capability
+  }
+
+  /**
+   * Look one capability up, dropping it when expired.
+   * @param token - the route segment.
+   * @param now - epoch milliseconds, injectable for tests.
+   * @returns the capability, or undefined when unknown or expired.
+   */
+  get(token: string, now = Date.now()): StaticCapability | undefined {
+    const value = this.#entries.get(token)
+    if (value === undefined) return undefined
+    if (value.expiresAt <= now) {
+      this.#entries.delete(token)
+      return undefined
+    }
+    return value
+  }
+
+  /**
+   * Drop every expired capability.
+   * @param now - epoch milliseconds, injectable for tests.
+   */
+  prune(now = Date.now()): void {
+    for (const [token, value] of this.#entries) {
+      if (value.expiresAt <= now) this.#entries.delete(token)
+    }
+  }
+}
+
+/**
+ * Resolve one asset request inside a capability.
+ *
+ * A path with no extension falls back to the entry, so a client-side route can
+ * deep-link inside a single-page preview without a directory listing.
+ * @param capability - the capability serving the request.
+ * @param requestPath - the decoded path below the capability token.
+ * @returns the asset's absolute path and content type.
+ * @throws {Error} when nothing contained matches and no entry fallback applies.
+ */
+export async function resolveCapabilityAsset(
+  capability: StaticCapability,
+  requestPath: string,
+): Promise<{ path: string, contentType: string }> {
+  let decoded: string
+  try {
+    decoded = decodeURIComponent(requestPath)
+  } catch {
+    throw new Error('invalid preview asset encoding')
+  }
+  const requested = decoded === '' ? capability.entry : decoded
+  try {
+    const target = await resolveContainedPath(capability.root, requested)
+    const info = await stat(target.path)
+    if (!info.isFile()) throw new Error('preview asset is not a file')
+    return { path: target.path, contentType: mimeType(target.path) }
+  } catch (error) {
+    if (extname(requested) !== '') throw error
+    const fallback = await resolveContainedPath(capability.root, capability.entry)
+    return { path: fallback.path, contentType: 'text/html; charset=utf-8' }
+  }
+}
+
+/**
+ * Read one asset, appending the navigation bridge to HTML documents.
+ * @param asset - the resolved asset.
+ * @returns the bytes to serve.
+ * @throws {Error} when the asset exceeds {@link MAX_ASSET_BYTES}.
+ */
+export async function readAsset(asset: { path: string, contentType: string }): Promise<Buffer> {
+  const info = await stat(asset.path)
+  if (info.size > MAX_ASSET_BYTES) throw new Error('preview asset exceeds the 16 MiB limit')
+  const content = await readFile(asset.path)
+  return asset.contentType.startsWith('text/html')
+    ? Buffer.concat([content, Buffer.from(PREVIEW_NAVIGATION_BRIDGE)])
+    : content
+}
+
+/**
+ * Answer a capability miss without describing the filesystem.
+ * @param res - the response to finish.
+ * @param status - the status to send.
+ */
+export function endWithStatus(res: ServerResponse, status: number): void {
+  res.writeHead(status, { 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff' })
+  res.end('not found')
+}
