index 0000000000000000000000000000000000000000..ac6e3f0238029d8a1f276b96ee9c846a77c0f867
--- /dev/null
+++ b/packages/host/preview-static/tests/capability.host.spec.ts
@@ -0,0 +1,160 @@
+/**
+ * The containment fence and the capability table.
+ *
+ * These are the two things standing between a LAN peer and the user's
+ * workspace, so each refusal is asserted directly rather than inferred from a
+ * route response: a traversal, a blocked name, a symlink that leaves the
+ * capability root, and an expired token must all answer nothing.
+ */
+import { mkdtemp, mkdir, realpath, rm, symlink, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import {
+  isBlockedPreviewPath,
+  MAX_ASSET_BYTES,
+  PreviewCapabilities,
+  readAsset,
+  resolveCapabilityAsset,
+  resolveContainedPath,
+  securityHeaders,
+} from '../src/capability.ts'
+
+let root: string
+
+beforeEach(async () => {
+  // Every resolved path comes back canonical, so the fixture records the
+  // canonical root too: macOS hands out `/var/...`, which realpath rewrites to
+  // `/private/var/...`.
+  root = await realpath(await mkdtemp(join(tmpdir(), 'preview-static-')))
+  await mkdir(join(root, 'pages'))
+  await writeFile(join(root, 'index.html'), '<!doctype html><title>a</title>')
+  await writeFile(join(root, 'pages', 'index.html'), '<!doctype html><title>b</title>')
+  await writeFile(join(root, 'pages', 'style.css'), 'body{}')
+  await writeFile(join(root, '.env'), 'SECRET=1')
+  await writeFile(join(root, 'id_rsa'), 'key')
+})
+
+afterEach(async () => { await rm(root, { recursive: true, force: true }) })
+
+describe('blocked names', () => {
+  it('refuses secrets and dependency trees at any depth', () => {
+    expect(isBlockedPreviewPath('.env')).toBe(true)
+    expect(isBlockedPreviewPath('pages/.env.local')).toBe(true)
+    expect(isBlockedPreviewPath('node_modules/pkg/index.js')).toBe(true)
+    expect(isBlockedPreviewPath('.git/config')).toBe(true)
+    expect(isBlockedPreviewPath('certs/site.pem')).toBe(true)
+    expect(isBlockedPreviewPath('pages/style.css')).toBe(false)
+  })
+})
+
+describe('containment', () => {
+  it('resolves a contained file to its canonical path', async () => {
+    await expect(resolveContainedPath(root, 'pages/style.css'))
+      .resolves.toMatchObject({ path: join(root, 'pages', 'style.css') })
+  })
+
+  it('refuses traversal, absolute paths, and blocked names', async () => {
+    await expect(resolveContainedPath(root, '../outside.html')).rejects.toThrow()
+    await expect(resolveContainedPath(root, 'pages/../../outside.html')).rejects.toThrow()
+    await expect(resolveContainedPath(root, '/etc/passwd')).rejects.toThrow()
+    await expect(resolveContainedPath(root, 'C:\\windows\\win.ini')).rejects.toThrow()
+    await expect(resolveContainedPath(root, 'pages//style.css')).rejects.toThrow()
+    await expect(resolveContainedPath(root, 'pages/./style.css')).rejects.toThrow()
+    await expect(resolveContainedPath(root, '.env')).rejects.toThrow()
+    await expect(resolveContainedPath(root, 'id_rsa')).rejects.toThrow()
+  })
+
+  it('treats the empty path as the capability root itself', async () => {
+    await expect(resolveContainedPath(root, '')).resolves.toEqual({ root, path: root })
+  })
+
+  it('refuses a symlink whose realpath leaves the root', async () => {
+    const outside = await mkdtemp(join(tmpdir(), 'preview-outside-'))
+    try {
+      await writeFile(join(outside, 'secret.html'), 'secret')
+      await symlink(join(outside, 'secret.html'), join(root, 'pages', 'link.html'))
+      // The lexical path is contained; only the realpath check sees the escape.
+      await expect(resolveContainedPath(root, 'pages/link.html')).rejects.toThrow()
+    } finally {
+      await rm(outside, { recursive: true, force: true })
+    }
+  })
+})
+
+describe('the capability table', () => {
+  it('mints a capability rooted at the entry\'s directory', async () => {
+    const capabilities = new PreviewCapabilities()
+    const capability = await capabilities.create(root, 'pages/index.html')
+    expect(capability.root).toBe(join(root, 'pages'))
+    expect(capability.entry).toBe('index.html')
+    expect(capability.token).toMatch(/^[\w-]{32}$/u)
+    expect(capabilities.get(capability.token)).toBe(capability)
+  })
+
+  it('only mints for an HTML entry', async () => {
+    const capabilities = new PreviewCapabilities()
+    await expect(capabilities.create(root, 'pages/style.css')).rejects.toThrow()
+    await expect(capabilities.create(root, 'missing.html')).rejects.toThrow()
+    await expect(capabilities.create(root, '.env')).rejects.toThrow()
+  })
+
+  it('forgets an expired token', async () => {
+    const capabilities = new PreviewCapabilities()
+    const now = 1_000
+    const capability = await capabilities.create(root, 'index.html', now)
+    expect(capabilities.get(capability.token, now + 1)).toBe(capability)
+    expect(capabilities.get(capability.token, capability.expiresAt)).toBeUndefined()
+    expect(capabilities.get('unknown')).toBeUndefined()
+  })
+
+  it('bounds how many capabilities stay live', async () => {
+    const capabilities = new PreviewCapabilities()
+    const first = await capabilities.create(root, 'index.html')
+    for (let index = 0; index < 40; index += 1) {
+      await capabilities.create(root, 'index.html')
+    }
+    expect(capabilities.get(first.token)).toBeUndefined()
+  })
+})
+
+describe('asset resolution', () => {
+  it('serves the entry for the capability root and for an extensionless path', async () => {
+    const capabilities = new PreviewCapabilities()
+    const capability = await capabilities.create(root, 'pages/index.html')
+    await expect(resolveCapabilityAsset(capability, ''))
+      .resolves.toMatchObject({ path: join(root, 'pages', 'index.html') })
+    await expect(resolveCapabilityAsset(capability, 'some/route'))
+      .resolves.toMatchObject({ path: join(root, 'pages', 'index.html') })
+    await expect(resolveCapabilityAsset(capability, 'style.css'))
+      .resolves.toMatchObject({ contentType: 'text/css; charset=utf-8' })
+  })
+
+  it('refuses an asset outside the capability root even with a token', async () => {
+    const capabilities = new PreviewCapabilities()
+    const capability = await capabilities.create(root, 'pages/index.html')
+    await expect(resolveCapabilityAsset(capability, '../index.html')).rejects.toThrow()
+    await expect(resolveCapabilityAsset(capability, '%2e%2e/index.html')).rejects.toThrow()
+    await expect(resolveCapabilityAsset(capability, 'missing.css')).rejects.toThrow()
+  })
+})
+
+describe('served bytes and headers', () => {
+  it('appends the navigation bridge to HTML only', async () => {
+    const capabilities = new PreviewCapabilities()
+    const capability = await capabilities.create(root, 'pages/index.html')
+    const html = await readAsset(await resolveCapabilityAsset(capability, ''))
+    expect(html.toString('utf8')).toContain('deepviewer-preview-browser')
+    const css = await readAsset(await resolveCapabilityAsset(capability, 'style.css'))
+    expect(css.toString('utf8')).toBe('body{}')
+  })
+
+  it('keeps a same-site frame-ancestors policy and never caches', () => {
+    const headers = securityHeaders('text/html; charset=utf-8', 12)
+    expect(headers['Content-Security-Policy']).toContain("frame-ancestors 'self'")
+    expect(headers['Content-Security-Policy']).toContain("connect-src 'none'")
+    expect(headers['Cache-Control']).toBe('no-store')
+    expect(headers['Content-Length']).toBe(12)
+    expect(MAX_ASSET_BYTES).toBe(16 * 1024 * 1024)
+  })
+})
