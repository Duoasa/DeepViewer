+    const s = draft.trimStart();
+    if (s.startsWith(token))
+        return s.slice(token.length);
+    const base = token.trimEnd();
+    if (s.startsWith(base)) {
+        const rest = s.slice(base.length);
+        return /^\s/.test(rest) ? rest.slice(1) : rest;
+    }
+    return '';
