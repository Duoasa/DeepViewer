{
  "name": "@deepviewer/desktop",
  "productName": "DeepViewer",
  "version": "0.5.0",
  "buildNumber": 90,
  "previewRelease": "0.5.0-preview.1",
  "private": true,
  "description": "DeepViewer agent workspace for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "node scripts/bump-build-number.mjs && node scripts/build-native-desktop.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:restart": "node scripts/dev.mjs --restart",
    "preview": "node scripts/package-native.mjs --preview",
    "release": "node scripts/package-native.mjs --release",
    "start": "pnpm build && electron .",
    "runtime": "node scripts/build-native-desktop.mjs --runtime",
    "runtime:arm64": "node scripts/build-native-desktop.mjs --runtime",
    "package": "node scripts/package-native.mjs",
    "package:arm64": "node scripts/package-native.mjs --arch=arm64",
    "test": "pnpm smoke",
    "typecheck": "tsc --noEmit",
    "smoke": "vitest run test/native-workspace.test.ts test/native-package-closure.test.ts test/native-migration.test.ts test/native-modules.test.ts test/user-data-migration.test.ts test/profile-migration.test.ts test/dock-theme.test.ts test/network-policy.test.ts test/network-access.test.ts test/network-bridge.test.ts test/subscriptions-v4.test.ts test/subscriptions-ui-adapter.test.ts test/development-workflow.test.ts test/development-inputs.test.ts test/native-release-audit.test.ts",
    "smoke:data": "node --expose-internals scripts/smoke-user-data.mjs",
    "build:dev": "node scripts/bump-build-number.mjs && node scripts/build-native-desktop.mjs",
    "smoke:native": "node scripts/smoke-native-host.mjs && node scripts/smoke-native-renderer.mjs && node scripts/smoke-native-web-state.mjs && node scripts/smoke-native-updates.mjs",
    "publish:update": "node scripts/publish-native-update.mjs --publish",
    "smoke:plugins": "node scripts/smoke-model-capabilities-host.mjs && node ../dsh-plugin-model-capabilities/scripts/smoke-runtime.mjs",
    "smoke:contracts": "node scripts/smoke-native-adapter-contracts.mjs",
    "smoke:payload": "node scripts/prepare-native-runtime.mjs && node scripts/smoke-native-payload.mjs",
    "smoke:source": "node scripts/smoke-native-contract-source.mjs",
    "smoke:synapse": "node --test ../deepviewer-adapter/tests/synapse-host.test.mjs && node scripts/smoke-native-synapse-client.mjs && node scripts/smoke-native-synapse-seams.mjs && node scripts/smoke-native-synapse-canvas.mjs",
    "smoke:ui-regression": "node scripts/smoke-native-ui-regression.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/get": "5.1.0",
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "electron": "44.0.0",
    "pnpm": "11.19.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@codemirror/search": "6.7.2",
    "@types/js-yaml": "4.0.9"
  },
  "dependencies": {
    "dsh-plugin-subscriptions": "0.3.1",
    "ipaddr.js": "2.5.0",
    "socks": "2.8.7",
    "js-yaml": "4.1.1"
  }
}
